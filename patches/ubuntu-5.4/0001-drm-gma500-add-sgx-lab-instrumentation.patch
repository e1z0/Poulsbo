From 36a5b101b408f5b90bbaba8f1e5b31775241fd54 Mon Sep 17 00:00:00 2001
From: e1z0 <e1z0@icloud.com>
Date: Fri, 15 May 2026 18:49:52 +0300
Subject: [PATCH] drm/gma500: add SGX TA submit-op request command

---
 drivers/gpu/drm/gma500/psb_drv.c | 107 +++++++++++++++++++++++++------
 1 file changed, 87 insertions(+), 20 deletions(-)

diff --git a/drivers/gpu/drm/gma500/psb_drv.c b/drivers/gpu/drm/gma500/psb_drv.c
index de3af6378..c6ae12394 100644
--- a/drivers/gpu/drm/gma500/psb_drv.c
+++ b/drivers/gpu/drm/gma500/psb_drv.c
@@ -2970,6 +2970,21 @@ struct psb_sgx_lab_submit_sgx_ta_submit_op_request_origin {
 	u32 request_origin_op;
 };
 
+struct psb_sgx_lab_submit_sgx_ta_submit_op_request_command {
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_origin
+		submit_op_request_origin;
+	struct drm_psb_sgx_lab_submit_op request_op;
+	struct drm_psb_sgx_lab_submit_op response_op;
+	struct psb_sgx_lab_submit_sgx_ta_request_work_outcome outcome;
+	bool active;
+	bool dependency_fields_present;
+	bool compatibility_request_command;
+	bool issue_request_command;
+	bool transition_request_command;
+	u32 resolved_submit_id;
+	u32 request_command_op;
+};
+
 static u32 poulsbo_sgx_lab_status_value(u32 seed, bool is_3d, u32 index);
 static int poulsbo_sgx_queue_region_end(u32 base_offset, u32 queue_size,
 					u32 *end_out);
@@ -20266,6 +20281,66 @@ out_free_origin:
 	return ret;
 }
 
+static int poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_command(
+	struct drm_device *dev,
+	u32 op_kind,
+	u32 submit_id,
+	u32 owner_state,
+	u32 packet_count,
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_command **return_out)
+{
+	struct drm_psb_sgx_lab_submit_op op = {};
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_origin *origin = NULL;
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_command *command;
+	int ret;
+
+	if (!dev || !return_out)
+		return -EINVAL;
+	if (op_kind != DRM_PSB_SGX_LAB_SUBMIT_OP_ISSUE &&
+	    op_kind != DRM_PSB_SGX_LAB_SUBMIT_OP_TRANSITION)
+		return -EINVAL;
+
+	*return_out = NULL;
+	command = kzalloc(sizeof(*command), GFP_KERNEL);
+	if (!command)
+		return -ENOMEM;
+
+	op.op = op_kind;
+	op.submit_id = submit_id;
+	op.owner_state = owner_state;
+	op.packet_count = packet_count;
+
+	ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_origin(
+		dev, &op, false, false, &origin);
+	if (ret)
+		goto out_free_command;
+
+	command->submit_op_request_origin = *origin;
+	command->request_op = origin->request_op;
+	command->response_op = origin->response_op;
+	command->outcome = origin->outcome;
+	command->active = origin->active;
+	command->dependency_fields_present =
+		origin->dependency_fields_present;
+	command->compatibility_request_command =
+		origin->compatibility_request_origin;
+	command->issue_request_command =
+		origin->issue_request_origin;
+	command->transition_request_command =
+		origin->transition_request_origin;
+	command->resolved_submit_id = origin->resolved_submit_id;
+	command->request_command_op = op_kind;
+
+	kfree(origin);
+	*return_out = command;
+	return 0;
+
+out_free_command:
+	kfree(origin);
+	kfree(command);
+	return ret;
+}
+
 static int poulsbo_sgx_prepare_queue_packets_locked(
 	struct psb_sgx_lab_object *control_obj,
 	struct psb_sgx_lab_submit *submit,
@@ -22748,36 +22823,28 @@ static int poulsbo_sgx_transition_submit(struct drm_device *dev,
 					 u32 owner_state,
 					 u32 completed_packets)
 {
-	struct drm_psb_sgx_lab_submit_op op = {};
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_origin *origin = NULL;
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_command *command =
+		NULL;
 	int ret;
 
-	op.op = DRM_PSB_SGX_LAB_SUBMIT_OP_TRANSITION;
-	op.submit_id = submit_id;
-	op.owner_state = owner_state;
-	op.packet_count = completed_packets;
-
-	ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_origin(
-		dev, &op, false, false, &origin);
-	kfree(origin);
+	ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_command(
+		dev, DRM_PSB_SGX_LAB_SUBMIT_OP_TRANSITION, submit_id,
+		owner_state, completed_packets, &command);
+	kfree(command);
 	return ret;
 }
 
 static int poulsbo_sgx_issue_submit(struct drm_device *dev, u32 submit_id,
 				    u32 owner_state, u32 issued_packets)
 {
-	struct drm_psb_sgx_lab_submit_op op = {};
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_origin *origin = NULL;
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_command *command =
+		NULL;
 	int ret;
 
-	op.op = DRM_PSB_SGX_LAB_SUBMIT_OP_ISSUE;
-	op.submit_id = submit_id;
-	op.owner_state = owner_state;
-	op.packet_count = issued_packets;
-
-	ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_origin(
-		dev, &op, false, false, &origin);
-	kfree(origin);
+	ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_command(
+		dev, DRM_PSB_SGX_LAB_SUBMIT_OP_ISSUE, submit_id,
+		owner_state, issued_packets, &command);
+	kfree(command);
 	return ret;
 }
 
-- 
