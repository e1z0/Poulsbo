+	}
+	if (!submit->status_object_id) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+	if (result_offset & 0x3) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+
+	status_obj = poulsbo_sgx_find_object_locked(dev_priv,
