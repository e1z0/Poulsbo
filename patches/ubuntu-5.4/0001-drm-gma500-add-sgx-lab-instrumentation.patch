From 6ad7ea82aecca5254a96e70d452afbc558e66660 Mon Sep 17 00:00:00 2001
From: e1z0 <e1z0@icloud.com>
Date: Fri, 15 May 2026 21:15:06 +0300
Subject: [PATCH] drm/gma500: fold SGX TA request public into request ioctl

---
 drivers/gpu/drm/gma500/psb_drv.c | 89 ++++++--------------------------
 1 file changed, 15 insertions(+), 74 deletions(-)

diff --git a/drivers/gpu/drm/gma500/psb_drv.c b/drivers/gpu/drm/gma500/psb_drv.c
index 67b929f87..2247919b1 100644
--- a/drivers/gpu/drm/gma500/psb_drv.c
+++ b/drivers/gpu/drm/gma500/psb_drv.c
@@ -2908,7 +2908,7 @@ struct psb_sgx_lab_submit_sgx_ta_submit_op_request_alias {
 	u32 request_alias_op;
 };
 
-struct psb_sgx_lab_submit_sgx_ta_submit_op_request_public {
+struct psb_sgx_lab_submit_sgx_ta_submit_op_request_ioctl {
 	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_terminal
 		submit_op_request_terminal;
 	struct drm_psb_sgx_lab_submit_op request_op;
@@ -2916,20 +2916,6 @@ struct psb_sgx_lab_submit_sgx_ta_submit_op_request_public {
 	struct psb_sgx_lab_submit_sgx_ta_request_work_outcome outcome;
 	bool active;
 	bool dependency_fields_present;
-	bool issue_request_public;
-	bool transition_request_public;
-	u32 resolved_submit_id;
-	u32 request_public_op;
-};
-
-struct psb_sgx_lab_submit_sgx_ta_submit_op_request_ioctl {
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_public
-		submit_op_request_public;
-	struct drm_psb_sgx_lab_submit_op request_op;
-	struct drm_psb_sgx_lab_submit_op response_op;
-	struct psb_sgx_lab_submit_sgx_ta_request_work_outcome outcome;
-	bool active;
-	bool dependency_fields_present;
 	bool issue_request_ioctl;
 	bool transition_request_ioctl;
 	u32 resolved_submit_id;
@@ -20073,59 +20059,14 @@ out_free_alias:
 	return ret;
 }
 
-static int poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_public(
-	struct drm_device *dev,
-	const struct drm_psb_sgx_lab_submit_op *op,
-	bool dependency_fields_present,
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_public **return_out)
-{
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_terminal *terminal =
-		NULL;
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_public *public;
-	int ret;
-
-	if (!dev || !op || !return_out)
-		return -EINVAL;
-
-	*return_out = NULL;
-	public = kmalloc(sizeof(*public), GFP_KERNEL);
-	if (!public)
-		return -ENOMEM;
-
-	ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_terminal(
-		dev, op, dependency_fields_present, &terminal);
-	if (ret)
-		goto out_free_public;
-
-	public->submit_op_request_terminal = *terminal;
-	public->request_op = terminal->request_op;
-	public->response_op = terminal->response_op;
-	public->outcome = terminal->outcome;
-	public->active = terminal->active;
-	public->dependency_fields_present =
-		terminal->dependency_fields_present;
-	public->issue_request_public = terminal->issue_request_terminal;
-	public->transition_request_public =
-		terminal->transition_request_terminal;
-	public->resolved_submit_id = terminal->resolved_submit_id;
-	public->request_public_op = op->op;
-
-	kfree(terminal);
-	*return_out = public;
-	return 0;
-
-out_free_public:
-	kfree(public);
-	return ret;
-}
-
 static int poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_ioctl(
 	struct drm_device *dev,
 	const struct drm_psb_sgx_lab_submit_op *op,
 	bool dependency_fields_present,
 	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_ioctl **return_out)
 {
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_public *public = NULL;
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_terminal *terminal =
+		NULL;
 	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_ioctl *ioctl;
 	int ret;
 
@@ -20137,25 +20078,25 @@ static int poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_ioctl(
 	if (!ioctl)
 		return -ENOMEM;
 
-	ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_public(
-		dev, op, dependency_fields_present, &public);
+	ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_terminal(
+		dev, op, dependency_fields_present, &terminal);
 	if (ret)
 		goto out_free_ioctl;
 
-	ioctl->submit_op_request_public = *public;
-	ioctl->request_op = public->request_op;
-	ioctl->response_op = public->response_op;
-	ioctl->outcome = public->outcome;
-	ioctl->active = public->active;
+	ioctl->submit_op_request_terminal = *terminal;
+	ioctl->request_op = terminal->request_op;
+	ioctl->response_op = terminal->response_op;
+	ioctl->outcome = terminal->outcome;
+	ioctl->active = terminal->active;
 	ioctl->dependency_fields_present =
-		public->dependency_fields_present;
-	ioctl->issue_request_ioctl = public->issue_request_public;
+		terminal->dependency_fields_present;
+	ioctl->issue_request_ioctl = terminal->issue_request_terminal;
 	ioctl->transition_request_ioctl =
-		public->transition_request_public;
-	ioctl->resolved_submit_id = public->resolved_submit_id;
+		terminal->transition_request_terminal;
+	ioctl->resolved_submit_id = terminal->resolved_submit_id;
 	ioctl->request_ioctl_op = op->op;
 
-	kfree(public);
+	kfree(terminal);
 	*return_out = ioctl;
 	return 0;
 
-- 
2.34.1

