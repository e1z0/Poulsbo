 out_unlock:
 	mutex_unlock(&dev_priv->gtt_mutex);
@@ -11444,11 +11622,11 @@ out_unlock:
 	mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
 
 	if (ret) {
-		kfree(scheduler);
+		kfree(sequence);
 		return ret;
 	}
 
-	*scheduler_out = scheduler;
+	*sequence_out = sequence;
 	return 0;
 }
 
@@ -13934,12 +14112,12 @@ static int poulsbo_sgx_transition_submit(struct drm_device *dev,
 					 u32 owner_state,
 					 u32 completed_packets)
 {
-	struct psb_sgx_lab_submit_sgx_ta_scheduler *scheduler = NULL;
+	struct psb_sgx_lab_submit_sgx_ta_sequence *sequence = NULL;
 	int ret;
 
-	ret = poulsbo_sgx_execute_submit_sgx_ta_scheduler(
+	ret = poulsbo_sgx_execute_submit_sgx_ta_sequence(
 		dev, submit_id, PSB_SGX_LAB_SUBMIT_SGX_TA_OP_TRANSITION,
-		owner_state, completed_packets, &scheduler);
