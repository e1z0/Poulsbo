+int psb_gtt_lab_bind_pf(struct drm_device *dev, u32 range_id)
+{
+	struct drm_psb_private *dev_priv = dev->dev_private;
+	struct gtt_range *gt;
+	int ret;
+
+	mutex_lock(&dev_priv->gtt_mutex);
+	gt = psb_gtt_find_range_by_id_locked(dev_priv, range_id);
+	if (!gt) {
+		ret = -ENOENT;
+		goto out;
+	}
+
+	ret = psb_gtt_lab_bind_pf_locked(dev, gt);
+	if (!ret)
+		dev_info(dev->dev,
+			 "lab pf_bind id=%u name=%s gpu_va=%#08lx npage=%d active=%u total=%u\n",
+			 gt->debug_id,
+			 gt->resource.name ? gt->resource.name : "?",
+			 (unsigned long)(dev_priv->gtt.gatt_start + gt->offset),
+			 gt->npage, gt->sgx_pf_bind_count,
+			 gt->sgx_pf_bind_total);
+out:
+	mutex_unlock(&dev_priv->gtt_mutex);
+	return ret;
+}
+
+int psb_gtt_lab_unbind_pf(struct drm_device *dev, u32 range_id)
+{
+	struct drm_psb_private *dev_priv = dev->dev_private;
+	struct gtt_range *gt;
+	int ret;
+
+	mutex_lock(&dev_priv->gtt_mutex);
+	gt = psb_gtt_find_range_by_id_locked(dev_priv, range_id);
+	if (!gt) {
+		ret = -ENOENT;
+		goto out;
+	}
+
+	ret = psb_gtt_lab_unbind_pf_locked(dev, gt);
+	if (!ret)
+		dev_info(dev->dev,
+			 "lab pf_unbind id=%u name=%s gpu_va=%#08lx active=%u total=%u\n",
+			 gt->debug_id,
+			 gt->resource.name ? gt->resource.name : "?",
+			 (unsigned long)(dev_priv->gtt.gatt_start + gt->offset),
+			 gt->sgx_pf_bind_count,
+			 gt->sgx_pf_unbind_total);
+out:
+	mutex_unlock(&dev_priv->gtt_mutex);
+	return ret;
+}
+
+struct gtt_range *psb_gtt_lab_get_range(struct drm_device *dev, u32 range_id)
+{
+	struct drm_psb_private *dev_priv = dev->dev_private;
+	struct gtt_range *gt = NULL;
+
+	mutex_lock(&dev_priv->gtt_mutex);
+	gt = psb_gtt_find_range_by_id_locked(dev_priv, range_id);
+	if (gt)
+		drm_gem_object_get(&gt->gem);
+	mutex_unlock(&dev_priv->gtt_mutex);
+
+	return gt;
+}
+
+void psb_gtt_lab_put_range(struct gtt_range *gt)
+{
+	if (!gt)
+		return;
+
+	drm_gem_object_put_unlocked(&gt->gem);
+}
