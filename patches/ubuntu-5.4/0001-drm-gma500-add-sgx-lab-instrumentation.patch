 static int poulsbo_sgx_transition_submit(struct drm_device *dev,
 					 u32 submit_id,
 					 u32 owner_state,
 					 u32 completed_packets)
 {
 	struct drm_psb_sgx_lab_submit_op op = {};
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_alias *alias = NULL;
+	int ret;
 
 	op.op = DRM_PSB_SGX_LAB_SUBMIT_OP_TRANSITION;
 	op.submit_id = submit_id;
 	op.owner_state = owner_state;
 	op.packet_count = completed_packets;
 
-	return poulsbo_sgx_transition_submit_op_request(dev, &op, false, NULL);
+	ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_alias(
+		dev, &op, false, &alias);
+	kfree(alias);
+	return ret;
 }
 
