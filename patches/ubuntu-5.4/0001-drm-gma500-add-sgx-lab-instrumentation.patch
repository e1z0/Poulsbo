From 72521690a3de1ee04d8e9c70475a7696a9e3cfad Mon Sep 17 00:00:00 2001
From: e1z0 <e1z0@icloud.com>
Date: Wed, 13 May 2026 20:32:43 +0300
Subject: [PATCH] drm/gma500: add SGX TA job object

---
 drivers/gpu/drm/gma500/psb_drv.c | 286 +++++++++++++++++++++++++++----
 1 file changed, 249 insertions(+), 37 deletions(-)

diff --git a/drivers/gpu/drm/gma500/psb_drv.c b/drivers/gpu/drm/gma500/psb_drv.c
index f6cb28ce9..b6e852322 100644
--- a/drivers/gpu/drm/gma500/psb_drv.c
+++ b/drivers/gpu/drm/gma500/psb_drv.c
@@ -1628,6 +1628,28 @@ struct psb_sgx_lab_submit_sgx_ta_work_queue {
 	u32 base_transition_count;
 };
 
+struct psb_sgx_lab_submit_sgx_ta_job {
+	struct psb_sgx_lab_submit_sgx_ta_work_queue work_queue;
+	bool active;
+	u32 submit_id;
+	u32 context;
+	u32 cmd_type;
+	u32 ctrl_flags;
+	u32 control_object_id;
+	u32 pds_object_id;
+	u32 use_object_id;
+	u32 target_object_id;
+	u32 status_object_id;
+	u32 num_ta_status_vals;
+	u32 num_3d_status_vals;
+	u32 ta_dependency;
+	u32 active_dependency_count;
+	bool running_slot_busy;
+	bool can_enter_running;
+	struct psb_sgx_lab_submit_sgx_dependency_state
+		dependencies[PSB_SGX_LAB_DEPENDENCY_SLOTS];
+};
+
 static u32 poulsbo_sgx_lab_status_value(u32 seed, bool is_3d, u32 index);
 static int poulsbo_sgx_queue_region_end(u32 base_offset, u32 queue_size,
 					u32 *end_out);
@@ -5390,6 +5412,74 @@ static int poulsbo_sgx_apply_submit_sgx_ta_work_queue_locked(
 		dev_priv, submit, &work_queue->sequence);
 }
 
+static int poulsbo_sgx_build_submit_sgx_ta_job_locked(
+	struct drm_psb_private *dev_priv,
+	struct psb_sgx_lab_submit *submit,
+	u32 op_kind,
+	u32 owner_state,
+	u32 packet_count,
+	struct psb_sgx_lab_submit_sgx_ta_job *job)
+{
+	const struct psb_sgx_lab_submit_sgx_ta_control *control;
+	const struct psb_sgx_lab_submit_sgx_ta_runtime *runtime;
+	const struct psb_sgx_lab_submit_sgx_ta_gate *gate;
+	unsigned int slot;
+	int ret;
+
+	if (!dev_priv || !submit || !job)
+		return -EINVAL;
+
+	memset(job, 0, sizeof(*job));
+
+	ret = poulsbo_sgx_build_submit_sgx_ta_work_queue_locked(
+		dev_priv, submit, op_kind, owner_state, packet_count,
+		&job->work_queue);
+	if (ret)
+		return ret;
+	if (op_kind == PSB_SGX_LAB_SUBMIT_SGX_TA_OP_NONE)
+		return 0;
+
+	control =
+		&job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.path.dispatch.schedule.control;
+	runtime = &control->runtime;
+	gate = &control->gate;
+
+	job->active = true;
+	job->submit_id = submit->submit_id;
+	job->context = submit->context;
+	job->cmd_type = submit->cmd_type;
+	job->ctrl_flags = submit->ctrl_flags;
+	job->control_object_id = submit->control_object_id;
+	job->pds_object_id = submit->pds_object_id;
+	job->use_object_id = submit->use_object_id;
+	job->target_object_id = submit->target_object_id;
+	job->status_object_id = submit->status_object_id;
+	job->num_ta_status_vals = submit->num_ta_status_vals;
+	job->num_3d_status_vals = submit->num_3d_status_vals;
+	job->ta_dependency = submit->ta_dependency;
+	job->active_dependency_count = gate->active_dependency_count;
+	job->running_slot_busy = gate->running_slot_busy;
+	job->can_enter_running = gate->can_enter_running;
+	for (slot = 0; slot < PSB_SGX_LAB_DEPENDENCY_SLOTS; slot++)
+		job->dependencies[slot] = runtime->dependencies[slot];
+
+	return 0;
+}
+
+static int poulsbo_sgx_apply_submit_sgx_ta_job_locked(
+	struct drm_psb_private *dev_priv,
+	struct psb_sgx_lab_submit *submit,
+	const struct psb_sgx_lab_submit_sgx_ta_job *job)
+{
+	if (!dev_priv || !submit || !job)
+		return -EINVAL;
+	if (job->active && job->submit_id != submit->submit_id)
+		return -EINVAL;
+
+	return poulsbo_sgx_apply_submit_sgx_ta_work_queue_locked(
+		dev_priv, submit, &job->work_queue);
+}
+
 static int poulsbo_sgx_collect_submit_view_records_locked(
 	struct drm_psb_private *dev_priv,
 	struct psb_sgx_lab_submit *submit,
@@ -11374,6 +11464,97 @@ static int poulsbo_sgx_validate_built_submit_sgx_ta_work_queue_locked(
 	return 0;
 }
 
+static int poulsbo_sgx_validate_built_submit_sgx_ta_job_locked(
+	struct drm_psb_private *dev_priv,
+	struct psb_sgx_lab_submit *submit,
+	const struct psb_sgx_lab_submit_sgx_ta_job *job)
+{
+	const struct psb_sgx_lab_submit_sgx_ta_control *control;
+	const struct psb_sgx_lab_submit_sgx_ta_runtime *runtime;
+	const struct psb_sgx_lab_submit_sgx_ta_gate *gate;
+	bool active;
+	unsigned int slot;
+	int ret;
+
+	if (!dev_priv || !submit || !job)
+		return -EINVAL;
+
+	ret = poulsbo_sgx_validate_built_submit_sgx_ta_work_queue_locked(
+		dev_priv, submit, &job->work_queue);
+	if (ret)
+		return ret;
+
+	active = job->work_queue.sequence.scheduler.ta_op.op_kind !=
+		 PSB_SGX_LAB_SUBMIT_SGX_TA_OP_NONE;
+	if (job->active != active)
+		return -EINVAL;
+	if (!active) {
+		if (job->submit_id || job->context || job->cmd_type ||
+		    job->ctrl_flags || job->control_object_id ||
+		    job->pds_object_id || job->use_object_id ||
+		    job->target_object_id || job->status_object_id ||
+		    job->num_ta_status_vals || job->num_3d_status_vals ||
+		    job->ta_dependency || job->active_dependency_count ||
+		    job->running_slot_busy || job->can_enter_running) {
+			return -EINVAL;
+		}
+		for (slot = 0; slot < PSB_SGX_LAB_DEPENDENCY_SLOTS; slot++) {
+			if (job->dependencies[slot].active ||
+			    job->dependencies[slot].source_missing ||
+			    job->dependencies[slot].submit_id ||
+			    job->dependencies[slot].required_ticket ||
+			    job->dependencies[slot].observed_complete_ticket ||
+			    job->dependencies[slot].flags) {
+				return -EINVAL;
+			}
+		}
+		return 0;
+	}
+
+	control =
+		&job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.path.dispatch.schedule.control;
+	runtime = &control->runtime;
+	gate = &control->gate;
+
+	if (job->submit_id != submit->submit_id ||
+	    job->context != submit->context ||
+	    job->cmd_type != submit->cmd_type ||
+	    job->ctrl_flags != submit->ctrl_flags ||
+	    job->control_object_id != submit->control_object_id ||
+	    job->pds_object_id != submit->pds_object_id ||
+	    job->use_object_id != submit->use_object_id ||
+	    job->target_object_id != submit->target_object_id ||
+	    job->status_object_id != submit->status_object_id ||
+	    job->num_ta_status_vals != submit->num_ta_status_vals ||
+	    job->num_3d_status_vals != submit->num_3d_status_vals ||
+	    job->ta_dependency != submit->ta_dependency ||
+	    job->active_dependency_count != gate->active_dependency_count ||
+	    job->running_slot_busy != gate->running_slot_busy ||
+	    job->can_enter_running != gate->can_enter_running) {
+		return -EINVAL;
+	}
+
+	for (slot = 0; slot < PSB_SGX_LAB_DEPENDENCY_SLOTS; slot++) {
+		if (job->dependencies[slot].active !=
+			    runtime->dependencies[slot].active ||
+		    job->dependencies[slot].source_missing !=
+			    runtime->dependencies[slot].source_missing ||
+		    job->dependencies[slot].submit_id !=
+			    runtime->dependencies[slot].submit_id ||
+		    job->dependencies[slot].required_ticket !=
+			    runtime->dependencies[slot].required_ticket ||
+		    job->dependencies[slot].observed_complete_ticket !=
+			    runtime->dependencies[slot]
+				    .observed_complete_ticket ||
+		    job->dependencies[slot].flags !=
+			    runtime->dependencies[slot].flags) {
+			return -EINVAL;
+		}
+	}
+
+	return 0;
+}
+
 static int poulsbo_sgx_validate_submit_sgx_ta_work_item_locked(
 	struct drm_psb_private *dev_priv,
 	struct psb_sgx_lab_submit *submit,
@@ -11533,6 +11714,38 @@ out:
 	return ret;
 }
 
+static int poulsbo_sgx_validate_submit_sgx_ta_job_locked(
+	struct drm_psb_private *dev_priv,
+	struct psb_sgx_lab_submit *submit,
+	struct psb_sgx_lab_object *control_obj,
+	struct psb_sgx_lab_object *status_obj)
+{
+	struct psb_sgx_lab_submit_sgx_ta_job *job;
+	int ret;
+
+	job = kmalloc(sizeof(*job), GFP_KERNEL);
+	if (!job)
+		return -ENOMEM;
+
+	ret = poulsbo_sgx_validate_submit_sgx_ta_work_queue_locked(
+		dev_priv, submit, control_obj, status_obj);
+	if (ret)
+		goto out;
+
+	ret = poulsbo_sgx_build_submit_sgx_ta_job_locked(
+		dev_priv, submit, PSB_SGX_LAB_SUBMIT_SGX_TA_OP_NONE, 0, 0,
+		job);
+	if (ret)
+		goto out;
+
+	ret = poulsbo_sgx_validate_built_submit_sgx_ta_job_locked(
+		dev_priv, submit, job);
+
+out:
+	kfree(job);
+	return ret;
+}
+
 static int poulsbo_sgx_validate_submit_locked(struct drm_psb_private *dev_priv,
 					      struct psb_sgx_lab_submit *submit)
 {
@@ -11744,33 +11957,33 @@ static int poulsbo_sgx_validate_submit_locked(struct drm_psb_private *dev_priv,
 		submit, status_obj, NULL);
 	if (ret)
 		return ret;
-	return poulsbo_sgx_validate_submit_sgx_ta_work_queue_locked(
+	return poulsbo_sgx_validate_submit_sgx_ta_job_locked(
 		dev_priv, submit, control_obj, status_obj);
 }
 
-static int poulsbo_sgx_execute_submit_sgx_ta_work_queue(
+static int poulsbo_sgx_execute_submit_sgx_ta_job(
 	struct drm_device *dev,
 	u32 submit_id,
 	u32 op_kind,
 	u32 owner_state,
 	u32 packet_count,
-	struct psb_sgx_lab_submit_sgx_ta_work_queue **work_queue_out)
+	struct psb_sgx_lab_submit_sgx_ta_job **job_out)
 {
 	struct drm_psb_private *dev_priv;
 	struct psb_sgx_lab_submit *submit;
-	struct psb_sgx_lab_submit_sgx_ta_work_queue *work_queue;
+	struct psb_sgx_lab_submit_sgx_ta_job *job;
 	int ret;
 
-	if (!dev || !work_queue_out)
+	if (!dev || !job_out)
 		return -EINVAL;
 
 	dev_priv = dev->dev_private;
 	if (!dev_priv)
 		return -ENODEV;
 
-	*work_queue_out = NULL;
-	work_queue = kmalloc(sizeof(*work_queue), GFP_KERNEL);
-	if (!work_queue)
+	*job_out = NULL;
+	job = kmalloc(sizeof(*job), GFP_KERNEL);
+	if (!job)
 		return -ENOMEM;
 
 	mutex_lock(&dev_priv->sgx_lab_submit_mutex);
@@ -11783,14 +11996,13 @@ static int poulsbo_sgx_execute_submit_sgx_ta_work_queue(
 		goto out_unlock;
 	}
 
-	ret = poulsbo_sgx_build_submit_sgx_ta_work_queue_locked(
-		dev_priv, submit, op_kind, owner_state, packet_count,
-		work_queue);
+	ret = poulsbo_sgx_build_submit_sgx_ta_job_locked(
+		dev_priv, submit, op_kind, owner_state, packet_count, job);
 	if (ret)
 		goto out_unlock;
 
-	ret = poulsbo_sgx_apply_submit_sgx_ta_work_queue_locked(
-		dev_priv, submit, work_queue);
+	ret = poulsbo_sgx_apply_submit_sgx_ta_job_locked(dev_priv, submit,
+							 job);
 
 out_unlock:
 	mutex_unlock(&dev_priv->gtt_mutex);
@@ -11798,11 +12010,11 @@ out_unlock:
 	mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
 
 	if (ret) {
-		kfree(work_queue);
+		kfree(job);
 		return ret;
 	}
 
-	*work_queue_out = work_queue;
+	*job_out = job;
 	return 0;
 }
 
@@ -14288,12 +14500,12 @@ static int poulsbo_sgx_transition_submit(struct drm_device *dev,
 					 u32 owner_state,
 					 u32 completed_packets)
 {
-	struct psb_sgx_lab_submit_sgx_ta_work_queue *work_queue = NULL;
+	struct psb_sgx_lab_submit_sgx_ta_job *job = NULL;
 	int ret;
 
-	ret = poulsbo_sgx_execute_submit_sgx_ta_work_queue(
+	ret = poulsbo_sgx_execute_submit_sgx_ta_job(
 		dev, submit_id, PSB_SGX_LAB_SUBMIT_SGX_TA_OP_TRANSITION,
-		owner_state, completed_packets, &work_queue);
+		owner_state, completed_packets, &job);
 
 	if (!ret)
 		dev_info(dev->dev,
@@ -14301,35 +14513,35 @@ static int poulsbo_sgx_transition_submit(struct drm_device *dev,
 			 submit_id,
 			 poulsbo_sgx_lab_owner_state_name(owner_state),
 			 completed_packets,
-			 work_queue->sequence.scheduler.ta_op.work_item.event.commit.next_state.ccb_read_offset,
-			 work_queue->sequence.scheduler.ta_op.work_item.event.commit.next_state.ccb_write_offset,
-			 work_queue->sequence.scheduler.ta_op.work_item.event.commit.next_state.ccb_offset,
-			 work_queue->sequence.scheduler.ta_op.work_item.event.commit.next_state.queue_packet_count,
-			 !!work_queue->sequence.scheduler.ta_op.work_item.event.commit.next_state.queue_head_packet_count,
-			 work_queue->sequence.scheduler.ta_op.work_item.event.commit.next_state.sync_complete_seq,
-			 work_queue->sequence.scheduler.ta_op.work_item.event.commit.next_state.owner_complete_cookie,
-			 work_queue->sequence.scheduler.ta_op.work_item.event.commit.next_state.queue_epoch,
-			 work_queue->sequence.scheduler.next_state.running_ticket,
-			 work_queue->sequence.scheduler.next_state.complete_ticket);
-	kfree(work_queue);
+			 job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.ccb_read_offset,
+			 job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.ccb_write_offset,
+			 job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.ccb_offset,
+			 job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.queue_packet_count,
+			 !!job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.queue_head_packet_count,
+			 job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.sync_complete_seq,
+			 job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.owner_complete_cookie,
+			 job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.queue_epoch,
+			 job->work_queue.sequence.scheduler.next_state.running_ticket,
+			 job->work_queue.sequence.scheduler.next_state.complete_ticket);
+	kfree(job);
 	return ret;
 }
 
 static int poulsbo_sgx_issue_submit(struct drm_device *dev, u32 submit_id,
 				    u32 owner_state, u32 issued_packets)
 {
-	struct psb_sgx_lab_submit_sgx_ta_work_queue *work_queue = NULL;
+	struct psb_sgx_lab_submit_sgx_ta_job *job = NULL;
 	const struct psb_sgx_lab_submit_sgx_issue_image *issue_image;
 	int ret;
 
-	ret = poulsbo_sgx_execute_submit_sgx_ta_work_queue(
+	ret = poulsbo_sgx_execute_submit_sgx_ta_job(
 		dev, submit_id, PSB_SGX_LAB_SUBMIT_SGX_TA_OP_ISSUE,
-		owner_state, issued_packets, &work_queue);
+		owner_state, issued_packets, &job);
 	if (ret)
 		goto out;
 
 	issue_image =
-		&work_queue->sequence.scheduler.ta_op.work_item.event.commit.path.dispatch.issue_image;
+		&job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.path.dispatch.issue_image;
 
 	if (!ret)
 		dev_info(dev->dev,
@@ -14342,12 +14554,12 @@ static int poulsbo_sgx_issue_submit(struct drm_device *dev, u32 submit_id,
 			 issue_image->sync.pending_seq,
 			 issue_image->owner.owner_issue_cookie,
 			 issue_image->sync.epoch,
-			 work_queue->sequence.scheduler.ta_op.work_item.event.commit.path.dispatch.schedule.control.issue_request.plan.refilled_from_complete,
-			 work_queue->sequence.scheduler.next_state.issue_ticket,
-			 work_queue->sequence.scheduler.next_state.running_ticket);
+			 job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.path.dispatch.schedule.control.issue_request.plan.refilled_from_complete,
+			 job->work_queue.sequence.scheduler.next_state.issue_ticket,
+			 job->work_queue.sequence.scheduler.next_state.running_ticket);
 
 out:
-	kfree(work_queue);
+	kfree(job);
 	return ret;
 }
 
