-		}
-	} else if (owner_state == PSB_SGX_LAB_OWNER_RUNNING) {
-		if (submit->owner_state != PSB_SGX_LAB_OWNER_QUEUED &&
-		    submit->owner_state != PSB_SGX_LAB_OWNER_RUNNING) {
-			ret = -EINVAL;
-			goto out_unlock;
