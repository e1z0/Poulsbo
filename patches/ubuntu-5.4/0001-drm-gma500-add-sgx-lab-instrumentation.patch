+static struct gtt_range *
+psb_gtt_find_range_by_id_locked(struct drm_psb_private *dev_priv, u32 range_id)
+{
+	struct resource *res = dev_priv->gtt_mem ? dev_priv->gtt_mem->child : NULL;
+
+	while (res) {
+		struct gtt_range *gt = container_of(res, struct gtt_range,
+						    resource);
+
+		if (gt->debug_id == range_id)
+			return gt;
+		res = res->sibling;
+	}
+
+	return NULL;
+}
+
+static int psb_gtt_wait_idle_locked(struct drm_psb_private *dev_priv)
+{
+	int ret = gma_blt_wait_idle(dev_priv);
+
+	if (ret)
+		DRM_ERROR("Failed to idle the blitter, unpin failed!");
+
+	return ret;
+}
+
+static int psb_gtt_pin_locked(struct gtt_range *gt)
+{
+	int ret = 0;
+	struct drm_device *dev = gt->gem.dev;
+	struct drm_psb_private *dev_priv = dev->dev_private;
+	u32 gpu_base = dev_priv->gtt.gatt_start;
+
+	if (gt->in_gart == 0 && gt->stolen == 0) {
+		ret = psb_gtt_attach_pages(gt);
+		if (ret < 0)
+			return ret;
+		ret = psb_gtt_insert(dev, gt, 0);
+		if (ret < 0) {
+			psb_gtt_detach_pages(gt);
+			return ret;
+		}
+		ret = psb_mmu_insert_pages(psb_mmu_get_default_pd(dev_priv->mmu),
+					   gt->pages, gpu_base + gt->offset,
+					   gt->npage, 0, 0,
+					   PSB_MMU_CACHED_MEMORY);
+		if (ret < 0) {
+			psb_gtt_remove(dev, gt);
+			psb_gtt_detach_pages(gt);
+			return ret;
+		}
+	}
+
+	gt->in_gart++;
+	gt->pin_count_total++;
+	gt->last_pin_jiffies = jiffies;
+
+	return 0;
+}
+
+static int psb_gtt_unpin_locked(struct gtt_range *gt, bool idle_already_waited)
+{
+	struct drm_device *dev = gt->gem.dev;
+	struct drm_psb_private *dev_priv = dev->dev_private;
+	u32 gpu_base = dev_priv->gtt.gatt_start;
+	int ret = 0;
+
+	if (!idle_already_waited) {
+		ret = psb_gtt_wait_idle_locked(dev_priv);
+		if (ret)
+			return ret;
+	}
+
+	WARN_ON(!gt->in_gart);
+	if (!gt->in_gart)
+		return -EINVAL;
+
+	gt->in_gart--;
+	gt->unpin_count_total++;
+	gt->last_unpin_jiffies = jiffies;
+	if (gt->in_gart == 0 && gt->stolen == 0) {
+		psb_mmu_remove_pages(psb_mmu_get_default_pd(dev_priv->mmu),
+				     gpu_base + gt->offset, gt->npage, 0, 0);
+		psb_gtt_remove(dev, gt);
+		psb_gtt_detach_pages(gt);
+	}
+
+	return 0;
+}
+
+static int psb_gtt_lab_bind_pf_locked(struct drm_device *dev,
+				      struct gtt_range *gt)
+{
+	struct drm_psb_private *dev_priv = dev->dev_private;
+	unsigned long gpu_va = dev_priv->gtt.gatt_start + gt->offset;
+	int ret;
+
+	if (gt->stolen)
+		return -EINVAL;
+	if (!dev_priv->pf_pd)
+		return -ENODEV;
+
+	if (gt->sgx_pf_bind_count == 0) {
+		ret = psb_gtt_pin_locked(gt);
+		if (ret)
+			return ret;
+
+		ret = psb_mmu_insert_pages(dev_priv->pf_pd, gt->pages, gpu_va,
+					   gt->npage, 0, 0,
+					   PSB_MMU_CACHED_MEMORY);
+		if (ret) {
+			psb_gtt_unpin_locked(gt, false);
+			return ret;
+		}
+	}
+
+	gt->sgx_pf_bind_count++;
+	gt->sgx_pf_bind_total++;
+	gt->last_sgx_pf_bind_jiffies = jiffies;
+
+	return 0;
+}
+
+static int psb_gtt_lab_unbind_pf_locked(struct drm_device *dev,
+					struct gtt_range *gt)
+{
+	struct drm_psb_private *dev_priv = dev->dev_private;
+	unsigned long gpu_va = dev_priv->gtt.gatt_start + gt->offset;
+	int ret = 0;
+
+	if (!gt->sgx_pf_bind_count)
+		return -EINVAL;
+	if (!dev_priv->pf_pd)
+		return -ENODEV;
+
+	if (gt->sgx_pf_bind_count == 1) {
+		ret = psb_gtt_wait_idle_locked(dev_priv);
+		if (ret)
+			return ret;
+
+		psb_mmu_remove_pages(dev_priv->pf_pd, gpu_va, gt->npage, 0, 0);
+	}
+
+	gt->sgx_pf_bind_count--;
+	gt->sgx_pf_unbind_total++;
+	gt->last_sgx_pf_unbind_jiffies = jiffies;
+
+	if (gt->sgx_pf_bind_count == 0)
+		ret = psb_gtt_unpin_locked(gt, true);
+
+	return ret;
+}
