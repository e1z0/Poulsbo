From 6b49ec78c6541b7714b5d91a8f7107d277c47f11 Mon Sep 17 00:00:00 2001
From: e1z0 <e1z0@icloud.com>
Date: Wed, 13 May 2026 20:46:24 +0300
Subject: [PATCH] drm/gma500: add SGX TA request object

---
 drivers/gpu/drm/gma500/psb_drv.c | 274 +++++++++++++++++++++++++++----
 1 file changed, 238 insertions(+), 36 deletions(-)

diff --git a/drivers/gpu/drm/gma500/psb_drv.c b/drivers/gpu/drm/gma500/psb_drv.c
index b6e852322..ff79d40fa 100644
--- a/drivers/gpu/drm/gma500/psb_drv.c
+++ b/drivers/gpu/drm/gma500/psb_drv.c
@@ -1650,6 +1650,25 @@ struct psb_sgx_lab_submit_sgx_ta_job {
 		dependencies[PSB_SGX_LAB_DEPENDENCY_SLOTS];
 };
 
+struct psb_sgx_lab_submit_sgx_ta_request {
+	struct psb_sgx_lab_submit_sgx_ta_job job;
+	bool active;
+	u32 submit_id;
+	u32 op_kind;
+	u32 owner_state;
+	u32 packet_count;
+	bool issue_active;
+	bool transition_active;
+	bool refresh_views;
+	bool increment_issue_count;
+	bool increment_transition_count;
+	bool issue_advanced;
+	bool running_advanced;
+	bool complete_advanced;
+	bool active_running_changed;
+	struct psb_sgx_lab_submit_sgx_scheduler_state next_state;
+};
+
 static u32 poulsbo_sgx_lab_status_value(u32 seed, bool is_3d, u32 index);
 static int poulsbo_sgx_queue_region_end(u32 base_offset, u32 queue_size,
 					u32 *end_out);
@@ -5480,6 +5499,71 @@ static int poulsbo_sgx_apply_submit_sgx_ta_job_locked(
 		dev_priv, submit, &job->work_queue);
 }
 
+static int poulsbo_sgx_build_submit_sgx_ta_request_locked(
+	struct drm_psb_private *dev_priv,
+	struct psb_sgx_lab_submit *submit,
+	u32 op_kind,
+	u32 owner_state,
+	u32 packet_count,
+	struct psb_sgx_lab_submit_sgx_ta_request *request)
+{
+	const struct psb_sgx_lab_submit_sgx_ta_sequence *sequence;
+	const struct psb_sgx_lab_submit_sgx_ta_scheduler *scheduler;
+	const struct psb_sgx_lab_submit_sgx_ta_commit *commit;
+	int ret;
+
+	if (!dev_priv || !submit || !request)
+		return -EINVAL;
+
+	memset(request, 0, sizeof(*request));
+
+	ret = poulsbo_sgx_build_submit_sgx_ta_job_locked(
+		dev_priv, submit, op_kind, owner_state, packet_count,
+		&request->job);
+	if (ret)
+		return ret;
+	if (op_kind == PSB_SGX_LAB_SUBMIT_SGX_TA_OP_NONE)
+		return 0;
+
+	sequence = &request->job.work_queue.sequence;
+	scheduler = &sequence->scheduler;
+	commit = &scheduler->ta_op.work_item.event.commit;
+
+	request->active = true;
+	request->submit_id = submit->submit_id;
+	request->op_kind = request->job.work_queue.op_kind;
+	request->owner_state = request->job.work_queue.owner_state;
+	request->packet_count = request->job.work_queue.packet_count;
+	request->issue_active = commit->issue_active;
+	request->transition_active = commit->transition_active;
+	request->refresh_views = sequence->refresh_views;
+	request->increment_issue_count = sequence->increment_issue_count;
+	request->increment_transition_count =
+		sequence->increment_transition_count;
+	request->issue_advanced = scheduler->issue_advanced;
+	request->running_advanced = scheduler->running_advanced;
+	request->complete_advanced = scheduler->complete_advanced;
+	request->active_running_changed =
+		scheduler->active_running_changed;
+	request->next_state = scheduler->next_state;
+
+	return 0;
+}
+
+static int poulsbo_sgx_apply_submit_sgx_ta_request_locked(
+	struct drm_psb_private *dev_priv,
+	struct psb_sgx_lab_submit *submit,
+	const struct psb_sgx_lab_submit_sgx_ta_request *request)
+{
+	if (!dev_priv || !submit || !request)
+		return -EINVAL;
+	if (request->active && request->submit_id != submit->submit_id)
+		return -EINVAL;
+
+	return poulsbo_sgx_apply_submit_sgx_ta_job_locked(dev_priv, submit,
+							  &request->job);
+}
+
 static int poulsbo_sgx_collect_submit_view_records_locked(
 	struct drm_psb_private *dev_priv,
 	struct psb_sgx_lab_submit *submit,
@@ -11555,6 +11639,91 @@ static int poulsbo_sgx_validate_built_submit_sgx_ta_job_locked(
 	return 0;
 }
 
+static int poulsbo_sgx_validate_built_submit_sgx_ta_request_locked(
+	struct drm_psb_private *dev_priv,
+	struct psb_sgx_lab_submit *submit,
+	const struct psb_sgx_lab_submit_sgx_ta_request *request)
+{
+	const struct psb_sgx_lab_submit_sgx_ta_sequence *sequence;
+	const struct psb_sgx_lab_submit_sgx_ta_scheduler *scheduler;
+	const struct psb_sgx_lab_submit_sgx_ta_commit *commit;
+	const struct psb_sgx_lab_submit_sgx_scheduler_state zero_state = {};
+	bool active;
+	int ret;
+
+	if (!dev_priv || !submit || !request)
+		return -EINVAL;
+
+	ret = poulsbo_sgx_validate_built_submit_sgx_ta_job_locked(
+		dev_priv, submit, &request->job);
+	if (ret)
+		return ret;
+
+	active = request->job.work_queue.sequence.scheduler.ta_op.op_kind !=
+		 PSB_SGX_LAB_SUBMIT_SGX_TA_OP_NONE;
+	if (request->active != active)
+		return -EINVAL;
+	if (!active) {
+		if (request->submit_id || request->op_kind ||
+		    request->owner_state || request->packet_count ||
+		    request->issue_active || request->transition_active ||
+		    request->refresh_views ||
+		    request->increment_issue_count ||
+		    request->increment_transition_count ||
+		    request->issue_advanced || request->running_advanced ||
+		    request->complete_advanced ||
+		    request->active_running_changed) {
+			return -EINVAL;
+		}
+		return memcmp(&request->next_state, &zero_state,
+			      sizeof(zero_state)) ? -EINVAL : 0;
+	}
+
+	sequence = &request->job.work_queue.sequence;
+	scheduler = &sequence->scheduler;
+	commit = &scheduler->ta_op.work_item.event.commit;
+
+	if (request->submit_id != submit->submit_id ||
+	    request->op_kind != request->job.work_queue.op_kind ||
+	    request->owner_state != request->job.work_queue.owner_state ||
+	    request->packet_count != request->job.work_queue.packet_count ||
+	    request->issue_active != commit->issue_active ||
+	    request->transition_active != commit->transition_active ||
+	    request->refresh_views != sequence->refresh_views ||
+	    request->increment_issue_count !=
+		    sequence->increment_issue_count ||
+	    request->increment_transition_count !=
+		    sequence->increment_transition_count ||
+	    request->issue_advanced != scheduler->issue_advanced ||
+	    request->running_advanced != scheduler->running_advanced ||
+	    request->complete_advanced != scheduler->complete_advanced ||
+	    request->active_running_changed !=
+		    scheduler->active_running_changed) {
+		return -EINVAL;
+	}
+
+	if (request->next_state.issue_ticket !=
+		    scheduler->next_state.issue_ticket ||
+	    request->next_state.running_ticket !=
+		    scheduler->next_state.running_ticket ||
+	    request->next_state.complete_ticket !=
+		    scheduler->next_state.complete_ticket ||
+	    request->next_state.issue_submit_id !=
+		    scheduler->next_state.issue_submit_id ||
+	    request->next_state.running_submit_id !=
+		    scheduler->next_state.running_submit_id ||
+	    request->next_state.complete_submit_id !=
+		    scheduler->next_state.complete_submit_id ||
+	    request->next_state.active_running_valid !=
+		    scheduler->next_state.active_running_valid ||
+	    request->next_state.active_running_submit_id !=
+		    scheduler->next_state.active_running_submit_id) {
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
 static int poulsbo_sgx_validate_submit_sgx_ta_work_item_locked(
 	struct drm_psb_private *dev_priv,
 	struct psb_sgx_lab_submit *submit,
@@ -11746,6 +11915,38 @@ out:
 	return ret;
 }
 
+static int poulsbo_sgx_validate_submit_sgx_ta_request_locked(
+	struct drm_psb_private *dev_priv,
+	struct psb_sgx_lab_submit *submit,
+	struct psb_sgx_lab_object *control_obj,
+	struct psb_sgx_lab_object *status_obj)
+{
+	struct psb_sgx_lab_submit_sgx_ta_request *request;
+	int ret;
+
+	request = kmalloc(sizeof(*request), GFP_KERNEL);
+	if (!request)
+		return -ENOMEM;
+
+	ret = poulsbo_sgx_validate_submit_sgx_ta_job_locked(
+		dev_priv, submit, control_obj, status_obj);
+	if (ret)
+		goto out;
+
+	ret = poulsbo_sgx_build_submit_sgx_ta_request_locked(
+		dev_priv, submit, PSB_SGX_LAB_SUBMIT_SGX_TA_OP_NONE, 0, 0,
+		request);
+	if (ret)
+		goto out;
+
+	ret = poulsbo_sgx_validate_built_submit_sgx_ta_request_locked(
+		dev_priv, submit, request);
+
+out:
+	kfree(request);
+	return ret;
+}
+
 static int poulsbo_sgx_validate_submit_locked(struct drm_psb_private *dev_priv,
 					      struct psb_sgx_lab_submit *submit)
 {
@@ -11957,33 +12158,33 @@ static int poulsbo_sgx_validate_submit_locked(struct drm_psb_private *dev_priv,
 		submit, status_obj, NULL);
 	if (ret)
 		return ret;
-	return poulsbo_sgx_validate_submit_sgx_ta_job_locked(
+	return poulsbo_sgx_validate_submit_sgx_ta_request_locked(
 		dev_priv, submit, control_obj, status_obj);
 }
 
-static int poulsbo_sgx_execute_submit_sgx_ta_job(
+static int poulsbo_sgx_execute_submit_sgx_ta_request(
 	struct drm_device *dev,
 	u32 submit_id,
 	u32 op_kind,
 	u32 owner_state,
 	u32 packet_count,
-	struct psb_sgx_lab_submit_sgx_ta_job **job_out)
+	struct psb_sgx_lab_submit_sgx_ta_request **request_out)
 {
 	struct drm_psb_private *dev_priv;
 	struct psb_sgx_lab_submit *submit;
-	struct psb_sgx_lab_submit_sgx_ta_job *job;
+	struct psb_sgx_lab_submit_sgx_ta_request *request;
 	int ret;
 
-	if (!dev || !job_out)
+	if (!dev || !request_out)
 		return -EINVAL;
 
 	dev_priv = dev->dev_private;
 	if (!dev_priv)
 		return -ENODEV;
 
-	*job_out = NULL;
-	job = kmalloc(sizeof(*job), GFP_KERNEL);
-	if (!job)
+	*request_out = NULL;
+	request = kmalloc(sizeof(*request), GFP_KERNEL);
+	if (!request)
 		return -ENOMEM;
 
 	mutex_lock(&dev_priv->sgx_lab_submit_mutex);
@@ -11996,13 +12197,14 @@ static int poulsbo_sgx_execute_submit_sgx_ta_job(
 		goto out_unlock;
 	}
 
-	ret = poulsbo_sgx_build_submit_sgx_ta_job_locked(
-		dev_priv, submit, op_kind, owner_state, packet_count, job);
+	ret = poulsbo_sgx_build_submit_sgx_ta_request_locked(
+		dev_priv, submit, op_kind, owner_state, packet_count,
+		request);
 	if (ret)
 		goto out_unlock;
 
-	ret = poulsbo_sgx_apply_submit_sgx_ta_job_locked(dev_priv, submit,
-							 job);
+	ret = poulsbo_sgx_apply_submit_sgx_ta_request_locked(
+		dev_priv, submit, request);
 
 out_unlock:
 	mutex_unlock(&dev_priv->gtt_mutex);
@@ -12010,11 +12212,11 @@ out_unlock:
 	mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
 
 	if (ret) {
-		kfree(job);
+		kfree(request);
 		return ret;
 	}
 
-	*job_out = job;
+	*request_out = request;
 	return 0;
 }
 
@@ -14500,12 +14702,12 @@ static int poulsbo_sgx_transition_submit(struct drm_device *dev,
 					 u32 owner_state,
 					 u32 completed_packets)
 {
-	struct psb_sgx_lab_submit_sgx_ta_job *job = NULL;
+	struct psb_sgx_lab_submit_sgx_ta_request *request = NULL;
 	int ret;
 
-	ret = poulsbo_sgx_execute_submit_sgx_ta_job(
+	ret = poulsbo_sgx_execute_submit_sgx_ta_request(
 		dev, submit_id, PSB_SGX_LAB_SUBMIT_SGX_TA_OP_TRANSITION,
-		owner_state, completed_packets, &job);
+		owner_state, completed_packets, &request);
 
 	if (!ret)
 		dev_info(dev->dev,
@@ -14513,35 +14715,35 @@ static int poulsbo_sgx_transition_submit(struct drm_device *dev,
 			 submit_id,
 			 poulsbo_sgx_lab_owner_state_name(owner_state),
 			 completed_packets,
-			 job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.ccb_read_offset,
-			 job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.ccb_write_offset,
-			 job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.ccb_offset,
-			 job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.queue_packet_count,
-			 !!job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.queue_head_packet_count,
-			 job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.sync_complete_seq,
-			 job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.owner_complete_cookie,
-			 job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.queue_epoch,
-			 job->work_queue.sequence.scheduler.next_state.running_ticket,
-			 job->work_queue.sequence.scheduler.next_state.complete_ticket);
-	kfree(job);
+			 request->job.work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.ccb_read_offset,
+			 request->job.work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.ccb_write_offset,
+			 request->job.work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.ccb_offset,
+			 request->job.work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.queue_packet_count,
+			 !!request->job.work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.queue_head_packet_count,
+			 request->job.work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.sync_complete_seq,
+			 request->job.work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.owner_complete_cookie,
+			 request->job.work_queue.sequence.scheduler.ta_op.work_item.event.commit.next_state.queue_epoch,
+			 request->next_state.running_ticket,
+			 request->next_state.complete_ticket);
+	kfree(request);
 	return ret;
 }
 
 static int poulsbo_sgx_issue_submit(struct drm_device *dev, u32 submit_id,
 				    u32 owner_state, u32 issued_packets)
 {
-	struct psb_sgx_lab_submit_sgx_ta_job *job = NULL;
+	struct psb_sgx_lab_submit_sgx_ta_request *request = NULL;
 	const struct psb_sgx_lab_submit_sgx_issue_image *issue_image;
 	int ret;
 
-	ret = poulsbo_sgx_execute_submit_sgx_ta_job(
+	ret = poulsbo_sgx_execute_submit_sgx_ta_request(
 		dev, submit_id, PSB_SGX_LAB_SUBMIT_SGX_TA_OP_ISSUE,
-		owner_state, issued_packets, &job);
+		owner_state, issued_packets, &request);
 	if (ret)
 		goto out;
 
 	issue_image =
-		&job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.path.dispatch.issue_image;
+		&request->job.work_queue.sequence.scheduler.ta_op.work_item.event.commit.path.dispatch.issue_image;
 
 	if (!ret)
 		dev_info(dev->dev,
@@ -14554,12 +14756,12 @@ static int poulsbo_sgx_issue_submit(struct drm_device *dev, u32 submit_id,
 			 issue_image->sync.pending_seq,
 			 issue_image->owner.owner_issue_cookie,
 			 issue_image->sync.epoch,
-			 job->work_queue.sequence.scheduler.ta_op.work_item.event.commit.path.dispatch.schedule.control.issue_request.plan.refilled_from_complete,
-			 job->work_queue.sequence.scheduler.next_state.issue_ticket,
-			 job->work_queue.sequence.scheduler.next_state.running_ticket);
+			 request->job.work_queue.sequence.scheduler.ta_op.work_item.event.commit.path.dispatch.schedule.control.issue_request.plan.refilled_from_complete,
+			 request->next_state.issue_ticket,
+			 request->next_state.running_ticket);
 
 out:
-	kfree(job);
+	kfree(request);
 	return ret;
 }
 
