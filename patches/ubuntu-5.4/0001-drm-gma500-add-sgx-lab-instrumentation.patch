+	kfree(work_packet);
 	return ret;
 }
 
@@ -16652,40 +16881,38 @@ static int poulsbo_sgx_issue_submit_op_request(
 	const struct drm_psb_sgx_lab_submit_op *op,
 	bool dependency_fields_present)
 {
