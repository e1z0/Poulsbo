From c3fd2828c523ea86ff797ada4f1776aa6d26276d Mon Sep 17 00:00:00 2001
From: e1z0 <e1z0@icloud.com>
Date: Wed, 13 May 2026 17:19:04 +0300
Subject: [PATCH] drm/gma500: route SGX issue path through TA path

---
 drivers/gpu/drm/gma500/psb_drv.c | 27 +++++++++++++++++++--------
 1 file changed, 19 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/gma500/psb_drv.c b/drivers/gpu/drm/gma500/psb_drv.c
index d98e37759..b967b5013 100644
--- a/drivers/gpu/drm/gma500/psb_drv.c
+++ b/drivers/gpu/drm/gma500/psb_drv.c
@@ -4366,6 +4366,16 @@ static int poulsbo_sgx_submit_sgx_ta_path_transition_status_locked(
 		&path->dispatch.schedule);
 }
 
+static int poulsbo_sgx_submit_sgx_ta_path_issue_status_locked(
+	const struct psb_sgx_lab_submit_sgx_ta_path *path)
+{
+	if (!path)
+		return -EINVAL;
+
+	return poulsbo_sgx_submit_sgx_ta_dispatch_issue_status_locked(
+		&path->dispatch);
+}
+
 static int poulsbo_sgx_collect_submit_view_records_locked(
 	struct drm_psb_private *dev_priv,
 	struct psb_sgx_lab_submit *submit,
@@ -12943,7 +12953,7 @@ static int poulsbo_sgx_issue_submit(struct drm_device *dev, u32 submit_id,
 {
 	struct drm_psb_private *dev_priv = dev->dev_private;
 	struct psb_sgx_lab_submit *submit;
-	struct psb_sgx_lab_submit_sgx_ta_dispatch *dispatch = NULL;
+	struct psb_sgx_lab_submit_sgx_ta_path *path = NULL;
 	const struct psb_sgx_lab_submit_sgx_issue_image *issue_image;
 	struct psb_sgx_lab_object *control_obj;
 	struct psb_sgx_lab_object *pds_obj;
@@ -12985,23 +12995,24 @@ static int poulsbo_sgx_issue_submit(struct drm_device *dev, u32 submit_id,
 		goto out_unlock;
 	}
 
-	dispatch = kmalloc(sizeof(*dispatch), GFP_KERNEL);
-	if (!dispatch) {
+	path = kmalloc(sizeof(*path), GFP_KERNEL);
+	if (!path) {
 		ret = -ENOMEM;
 		goto out_unlock;
 	}
 
-	ret = poulsbo_sgx_build_submit_sgx_ta_dispatch_locked(
-		dev_priv, submit, true, owner_state, issued_packets, dispatch);
+	ret = poulsbo_sgx_build_submit_sgx_ta_path_locked(
+		dev_priv, submit, true, owner_state, issued_packets, false, 0, 0,
+		path);
 	if (ret)
 		goto out_unlock;
-	ret = poulsbo_sgx_submit_sgx_ta_dispatch_issue_status_locked(dispatch);
+	ret = poulsbo_sgx_submit_sgx_ta_path_issue_status_locked(path);
 	if (ret) {
 		if (ret == -ESTALE)
 			poulsbo_sgx_disarm_submit_locked(submit);
 		goto out_unlock;
 	}
-	issue_image = &dispatch->issue_image;
+	issue_image = &path->dispatch.issue_image;
 
 	control_obj = poulsbo_sgx_find_object_locked(dev_priv,
 						     submit->launch_control_object_id);
@@ -13116,7 +13127,7 @@ out_unlock:
 			 submit->launch_refilled_from_complete,
 			 issue_image->sync.global_issue_ticket,
 			 issue_image->owner.global_running_ticket);
-	kfree(dispatch);
+	kfree(path);
 	return ret;
 }
 
-- 
