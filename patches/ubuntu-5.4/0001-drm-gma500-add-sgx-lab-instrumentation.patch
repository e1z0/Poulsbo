From 9defa35048d13bd9a29e6f8d8d1d99078c1b79b2 Mon Sep 17 00:00:00 2001
From: e1z0 <e1z0@icloud.com>
Date: Sat, 16 May 2026 01:18:22 +0300
Subject: [PATCH] drm/gma500: fold SGX TA request terminal into request relay

---
 drivers/gpu/drm/gma500/psb_drv.c | 85 +++++---------------------------
 1 file changed, 13 insertions(+), 72 deletions(-)

diff --git a/drivers/gpu/drm/gma500/psb_drv.c b/drivers/gpu/drm/gma500/psb_drv.c
index 2748d06aa..f7701dc5d 100644
--- a/drivers/gpu/drm/gma500/psb_drv.c
+++ b/drivers/gpu/drm/gma500/psb_drv.c
@@ -2866,20 +2866,6 @@ struct psb_sgx_lab_submit_sgx_ta_submit_op_request_relay {
 	u32 request_relay_op;
 };
 
-struct psb_sgx_lab_submit_sgx_ta_submit_op_request_terminal {
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_relay
-		submit_op_request_relay;
-	struct drm_psb_sgx_lab_submit_op request_op;
-	struct drm_psb_sgx_lab_submit_op response_op;
-	struct psb_sgx_lab_submit_sgx_ta_request_work_outcome outcome;
-	bool active;
-	bool dependency_fields_present;
-	bool issue_request_terminal;
-	bool transition_request_terminal;
-	u32 resolved_submit_id;
-	u32 request_terminal_op;
-};
-
 static u32 poulsbo_sgx_lab_status_value(u32 seed, bool is_3d, u32 index);
 static int poulsbo_sgx_queue_region_end(u32 base_offset, u32 queue_size,
 					u32 *end_out);
@@ -19765,51 +19751,6 @@ out_free_relay:
 	return ret;
 }
 
-static int poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_terminal(
-	struct drm_device *dev,
-	const struct drm_psb_sgx_lab_submit_op *op,
-	bool dependency_fields_present,
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_terminal **return_out)
-{
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_relay *relay = NULL;
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_terminal *terminal;
-	int ret;
-
-	if (!dev || !op || !return_out)
-		return -EINVAL;
-
-	*return_out = NULL;
-	terminal = kmalloc(sizeof(*terminal), GFP_KERNEL);
-	if (!terminal)
-		return -ENOMEM;
-
-	ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_relay(
-		dev, op, dependency_fields_present, &relay);
-	if (ret)
-		goto out_free_terminal;
-
-	terminal->submit_op_request_relay = *relay;
-	terminal->request_op = relay->request_op;
-	terminal->response_op = relay->response_op;
-	terminal->outcome = relay->outcome;
-	terminal->active = relay->active;
-	terminal->dependency_fields_present =
-		relay->dependency_fields_present;
-	terminal->issue_request_terminal = relay->issue_request_relay;
-	terminal->transition_request_terminal =
-		relay->transition_request_relay;
-	terminal->resolved_submit_id = relay->resolved_submit_id;
-	terminal->request_terminal_op = op->op;
-
-	kfree(relay);
-	*return_out = terminal;
-	return 0;
-
-out_free_terminal:
-	kfree(terminal);
-	return ret;
-}
-
 static int poulsbo_sgx_prepare_queue_packets_locked(
 	struct psb_sgx_lab_object *control_obj,
 	struct psb_sgx_lab_submit *submit,
@@ -25931,7 +25872,7 @@ static int psb_ioctl_sgx_lab_submit_op(struct drm_device *dev, void *data,
 {
 	struct drm_psb_private *dev_priv = dev->dev_private;
 	struct drm_psb_sgx_lab_submit_op *op = data;
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_terminal *request_terminal =
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_relay *request_relay =
 		NULL;
 	const char *slot_name = NULL;
 	bool dependency_fields_present;
@@ -26182,16 +26123,16 @@ static int psb_ioctl_sgx_lab_submit_op(struct drm_device *dev, void *data,
 						op->packet_count);
 		break;
 	case DRM_PSB_SGX_LAB_SUBMIT_OP_ISSUE:
-		ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_terminal(
-			dev, op, dependency_fields_present, &request_terminal);
+		ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_relay(
+			dev, op, dependency_fields_present, &request_relay);
 		if (!ret)
-			submit_id = request_terminal->response_op.resolved_submit_id;
+			submit_id = request_relay->response_op.resolved_submit_id;
 		break;
 	case DRM_PSB_SGX_LAB_SUBMIT_OP_TRANSITION:
-		ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_terminal(
-			dev, op, dependency_fields_present, &request_terminal);
+		ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_relay(
+			dev, op, dependency_fields_present, &request_relay);
 		if (!ret)
-			submit_id = request_terminal->response_op.resolved_submit_id;
+			submit_id = request_relay->response_op.resolved_submit_id;
 		break;
 	case DRM_PSB_SGX_LAB_SUBMIT_OP_ATTACH:
 		if (op->owner_state || op->packet_count || op->context ||
@@ -26632,17 +26573,17 @@ static int psb_ioctl_sgx_lab_submit_op(struct drm_device *dev, void *data,
 		return -EINVAL;
 	}
 	if (ret)
-		goto out_free_request_terminal;
-	if (request_terminal) {
-		kfree(request_terminal);
-		request_terminal = NULL;
+		goto out_free_request_relay;
+	if (request_relay) {
+		kfree(request_relay);
+		request_relay = NULL;
 	}
 
 	op->resolved_submit_id = submit_id;
 	return 0;
 
-out_free_request_terminal:
-	kfree(request_terminal);
+out_free_request_relay:
+	kfree(request_relay);
 	return ret;
 }
 
-- 
2.34.1

