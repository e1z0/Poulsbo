 	ret = poulsbo_sgx_write_submit_ccb_record_locked(
-		control_obj, new_ccb_offset, &ccb_record);
+		control_obj, new_ccb_offset, &transition_image->ccb_record);
 	if (ret)
 		goto out_unlock;
-
-	memset(&sync, 0, sizeof(sync));
-	sync.read_offset = new_read_offset;
-	sync.write_offset = new_write_offset;
-	sync.complete_seq = new_sync_complete_seq;
-	sync.pending_seq = submit->sync_pending_seq;
-	sync.flags = new_sync_flags;
-	sync.epoch = submit->queue_epoch;
-	sync.global_issue_ticket = submit->global_issue_ticket;
 	ret = poulsbo_sgx_write_submit_sync_locked(status_obj,
-						   submit->sync_offset, &sync);
+						   submit->sync_offset,
