From 5ba8ee190301739bb6b7782670bafa4fcf6caf33 Mon Sep 17 00:00:00 2001
From: e1z0 <e1z0@icloud.com>
Date: Wed, 13 May 2026 20:11:26 +0300
Subject: [PATCH] drm/gma500: add SGX TA work queue object

---
 drivers/gpu/drm/gma500/psb_drv.c | 248 ++++++++++++++++++++++++++-----
 1 file changed, 212 insertions(+), 36 deletions(-)

diff --git a/drivers/gpu/drm/gma500/psb_drv.c b/drivers/gpu/drm/gma500/psb_drv.c
index 41b22bb11..f6cb28ce9 100644
--- a/drivers/gpu/drm/gma500/psb_drv.c
+++ b/drivers/gpu/drm/gma500/psb_drv.c
@@ -1616,6 +1616,18 @@ struct psb_sgx_lab_submit_sgx_ta_sequence {
 	u32 next_transition_count;
 };
 
+struct psb_sgx_lab_submit_sgx_ta_work_queue {
+	struct psb_sgx_lab_submit_sgx_ta_sequence sequence;
+	bool active;
+	u32 submit_id;
+	u32 op_kind;
+	u32 owner_state;
+	u32 packet_count;
+	struct psb_sgx_lab_submit_sgx_scheduler_state base_state;
+	u32 base_issue_count;
+	u32 base_transition_count;
+};
+
 static u32 poulsbo_sgx_lab_status_value(u32 seed, bool is_3d, u32 index);
 static int poulsbo_sgx_queue_region_end(u32 base_offset, u32 queue_size,
 					u32 *end_out);
@@ -5323,6 +5335,61 @@ static int poulsbo_sgx_apply_submit_sgx_ta_sequence_locked(
 	return poulsbo_sgx_refresh_submit_views_locked(dev_priv, submit);
 }
 
+static int poulsbo_sgx_build_submit_sgx_ta_work_queue_locked(
+	struct drm_psb_private *dev_priv,
+	struct psb_sgx_lab_submit *submit,
+	u32 op_kind,
+	u32 owner_state,
+	u32 packet_count,
+	struct psb_sgx_lab_submit_sgx_ta_work_queue *work_queue)
+{
+	const struct psb_sgx_lab_submit_sgx_ta_commit *commit;
+	const struct psb_sgx_lab_submit_sgx_coordination *coordination;
+	int ret;
+
+	if (!dev_priv || !submit || !work_queue)
+		return -EINVAL;
+
+	memset(work_queue, 0, sizeof(*work_queue));
+
+	ret = poulsbo_sgx_build_submit_sgx_ta_sequence_locked(
+		dev_priv, submit, op_kind, owner_state, packet_count,
+		&work_queue->sequence);
+	if (ret)
+		return ret;
+	if (op_kind == PSB_SGX_LAB_SUBMIT_SGX_TA_OP_NONE)
+		return 0;
+
+	commit = &work_queue->sequence.scheduler.ta_op.work_item.event.commit;
+	coordination =
+		&commit->path.dispatch.schedule.control.runtime.coordination;
+	work_queue->active = true;
+	work_queue->submit_id = submit->submit_id;
+	work_queue->op_kind = work_queue->sequence.scheduler.ta_op.op_kind;
+	work_queue->owner_state = work_queue->sequence.scheduler.ta_op.owner_state;
+	work_queue->packet_count = work_queue->sequence.scheduler.ta_op.packet_count;
+	poulsbo_sgx_fill_submit_sgx_scheduler_state_from_coordination(
+		coordination, &work_queue->base_state);
+	work_queue->base_issue_count = submit->issue_count;
+	work_queue->base_transition_count = submit->transition_count;
+
+	return 0;
+}
+
+static int poulsbo_sgx_apply_submit_sgx_ta_work_queue_locked(
+	struct drm_psb_private *dev_priv,
+	struct psb_sgx_lab_submit *submit,
+	const struct psb_sgx_lab_submit_sgx_ta_work_queue *work_queue)
+{
+	if (!dev_priv || !submit || !work_queue)
+		return -EINVAL;
+	if (work_queue->active && work_queue->submit_id != submit->submit_id)
+		return -EINVAL;
+
+	return poulsbo_sgx_apply_submit_sgx_ta_sequence_locked(
+		dev_priv, submit, &work_queue->sequence);
+}
+
 static int poulsbo_sgx_collect_submit_view_records_locked(
 	struct drm_psb_private *dev_priv,
 	struct psb_sgx_lab_submit *submit,
@@ -11230,6 +11297,83 @@ static int poulsbo_sgx_validate_built_submit_sgx_ta_sequence_locked(
 	return 0;
 }
 
+static int poulsbo_sgx_validate_built_submit_sgx_ta_work_queue_locked(
+	struct drm_psb_private *dev_priv,
+	struct psb_sgx_lab_submit *submit,
+	const struct psb_sgx_lab_submit_sgx_ta_work_queue *work_queue)
+{
+	const struct psb_sgx_lab_submit_sgx_ta_commit *commit;
+	const struct psb_sgx_lab_submit_sgx_coordination *coordination;
+	struct psb_sgx_lab_submit_sgx_scheduler_state base_state;
+	bool active;
+	int ret;
+
+	if (!dev_priv || !submit || !work_queue)
+		return -EINVAL;
+
+	ret = poulsbo_sgx_validate_built_submit_sgx_ta_sequence_locked(
+		dev_priv, submit, &work_queue->sequence);
+	if (ret)
+		return ret;
+
+	active = work_queue->sequence.scheduler.ta_op.op_kind !=
+		 PSB_SGX_LAB_SUBMIT_SGX_TA_OP_NONE;
+	if (work_queue->active != active)
+		return -EINVAL;
+	if (!active) {
+		if (work_queue->submit_id || work_queue->op_kind ||
+		    work_queue->owner_state || work_queue->packet_count ||
+		    work_queue->base_state.issue_ticket ||
+		    work_queue->base_state.running_ticket ||
+		    work_queue->base_state.complete_ticket ||
+		    work_queue->base_state.issue_submit_id ||
+		    work_queue->base_state.running_submit_id ||
+		    work_queue->base_state.complete_submit_id ||
+		    work_queue->base_state.active_running_valid ||
+		    work_queue->base_state.active_running_submit_id ||
+		    work_queue->base_issue_count ||
+		    work_queue->base_transition_count) {
+			return -EINVAL;
+		}
+		return 0;
+	}
+
+	commit = &work_queue->sequence.scheduler.ta_op.work_item.event.commit;
+	coordination =
+		&commit->path.dispatch.schedule.control.runtime.coordination;
+	poulsbo_sgx_fill_submit_sgx_scheduler_state_from_coordination(
+		coordination, &base_state);
+
+	if (work_queue->submit_id != submit->submit_id ||
+	    work_queue->op_kind != work_queue->sequence.scheduler.ta_op.op_kind ||
+	    work_queue->owner_state !=
+		    work_queue->sequence.scheduler.ta_op.owner_state ||
+	    work_queue->packet_count !=
+		    work_queue->sequence.scheduler.ta_op.packet_count ||
+	    work_queue->base_issue_count != submit->issue_count ||
+	    work_queue->base_transition_count != submit->transition_count)
+		return -EINVAL;
+
+	if (work_queue->base_state.issue_ticket != base_state.issue_ticket ||
+	    work_queue->base_state.running_ticket != base_state.running_ticket ||
+	    work_queue->base_state.complete_ticket !=
+		    base_state.complete_ticket ||
+	    work_queue->base_state.issue_submit_id !=
+		    base_state.issue_submit_id ||
+	    work_queue->base_state.running_submit_id !=
+		    base_state.running_submit_id ||
+	    work_queue->base_state.complete_submit_id !=
+		    base_state.complete_submit_id ||
+	    work_queue->base_state.active_running_valid !=
+		    base_state.active_running_valid ||
+	    work_queue->base_state.active_running_submit_id !=
+		    base_state.active_running_submit_id) {
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
 static int poulsbo_sgx_validate_submit_sgx_ta_work_item_locked(
 	struct drm_psb_private *dev_priv,
 	struct psb_sgx_lab_submit *submit,
@@ -11357,6 +11501,38 @@ out:
 	return ret;
 }
 
+static int poulsbo_sgx_validate_submit_sgx_ta_work_queue_locked(
+	struct drm_psb_private *dev_priv,
+	struct psb_sgx_lab_submit *submit,
+	struct psb_sgx_lab_object *control_obj,
+	struct psb_sgx_lab_object *status_obj)
+{
+	struct psb_sgx_lab_submit_sgx_ta_work_queue *work_queue;
+	int ret;
+
+	work_queue = kmalloc(sizeof(*work_queue), GFP_KERNEL);
+	if (!work_queue)
+		return -ENOMEM;
+
+	ret = poulsbo_sgx_validate_submit_sgx_ta_sequence_locked(
+		dev_priv, submit, control_obj, status_obj);
+	if (ret)
+		goto out;
+
+	ret = poulsbo_sgx_build_submit_sgx_ta_work_queue_locked(
+		dev_priv, submit, PSB_SGX_LAB_SUBMIT_SGX_TA_OP_NONE, 0, 0,
+		work_queue);
+	if (ret)
+		goto out;
+
+	ret = poulsbo_sgx_validate_built_submit_sgx_ta_work_queue_locked(
+		dev_priv, submit, work_queue);
+
+out:
+	kfree(work_queue);
+	return ret;
+}
+
 static int poulsbo_sgx_validate_submit_locked(struct drm_psb_private *dev_priv,
 					      struct psb_sgx_lab_submit *submit)
 {
@@ -11568,33 +11744,33 @@ static int poulsbo_sgx_validate_submit_locked(struct drm_psb_private *dev_priv,
 		submit, status_obj, NULL);
 	if (ret)
 		return ret;
-	return poulsbo_sgx_validate_submit_sgx_ta_sequence_locked(
+	return poulsbo_sgx_validate_submit_sgx_ta_work_queue_locked(
 		dev_priv, submit, control_obj, status_obj);
 }
 
-static int poulsbo_sgx_execute_submit_sgx_ta_sequence(
+static int poulsbo_sgx_execute_submit_sgx_ta_work_queue(
 	struct drm_device *dev,
 	u32 submit_id,
 	u32 op_kind,
 	u32 owner_state,
 	u32 packet_count,
-	struct psb_sgx_lab_submit_sgx_ta_sequence **sequence_out)
+	struct psb_sgx_lab_submit_sgx_ta_work_queue **work_queue_out)
 {
 	struct drm_psb_private *dev_priv;
 	struct psb_sgx_lab_submit *submit;
-	struct psb_sgx_lab_submit_sgx_ta_sequence *sequence;
+	struct psb_sgx_lab_submit_sgx_ta_work_queue *work_queue;
 	int ret;
 
-	if (!dev || !sequence_out)
+	if (!dev || !work_queue_out)
 		return -EINVAL;
 
 	dev_priv = dev->dev_private;
 	if (!dev_priv)
 		return -ENODEV;
 
-	*sequence_out = NULL;
-	sequence = kmalloc(sizeof(*sequence), GFP_KERNEL);
-	if (!sequence)
+	*work_queue_out = NULL;
+	work_queue = kmalloc(sizeof(*work_queue), GFP_KERNEL);
+	if (!work_queue)
 		return -ENOMEM;
 
 	mutex_lock(&dev_priv->sgx_lab_submit_mutex);
@@ -11607,14 +11783,14 @@ static int poulsbo_sgx_execute_submit_sgx_ta_sequence(
 		goto out_unlock;
 	}
 
-	ret = poulsbo_sgx_build_submit_sgx_ta_sequence_locked(
+	ret = poulsbo_sgx_build_submit_sgx_ta_work_queue_locked(
 		dev_priv, submit, op_kind, owner_state, packet_count,
-		sequence);
+		work_queue);
 	if (ret)
 		goto out_unlock;
 
-	ret = poulsbo_sgx_apply_submit_sgx_ta_sequence_locked(
-		dev_priv, submit, sequence);
+	ret = poulsbo_sgx_apply_submit_sgx_ta_work_queue_locked(
+		dev_priv, submit, work_queue);
 
 out_unlock:
 	mutex_unlock(&dev_priv->gtt_mutex);
@@ -11622,11 +11798,11 @@ out_unlock:
 	mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
 
 	if (ret) {
-		kfree(sequence);
+		kfree(work_queue);
 		return ret;
 	}
 
-	*sequence_out = sequence;
+	*work_queue_out = work_queue;
 	return 0;
 }
 
@@ -14112,12 +14288,12 @@ static int poulsbo_sgx_transition_submit(struct drm_device *dev,
 					 u32 owner_state,
 					 u32 completed_packets)
 {
-	struct psb_sgx_lab_submit_sgx_ta_sequence *sequence = NULL;
+	struct psb_sgx_lab_submit_sgx_ta_work_queue *work_queue = NULL;
 	int ret;
 
-	ret = poulsbo_sgx_execute_submit_sgx_ta_sequence(
+	ret = poulsbo_sgx_execute_submit_sgx_ta_work_queue(
 		dev, submit_id, PSB_SGX_LAB_SUBMIT_SGX_TA_OP_TRANSITION,
-		owner_state, completed_packets, &sequence);
+		owner_state, completed_packets, &work_queue);
 
 	if (!ret)
 		dev_info(dev->dev,
@@ -14125,35 +14301,35 @@ static int poulsbo_sgx_transition_submit(struct drm_device *dev,
 			 submit_id,
 			 poulsbo_sgx_lab_owner_state_name(owner_state),
 			 completed_packets,
-			 sequence->scheduler.ta_op.work_item.event.commit.next_state.ccb_read_offset,
-			 sequence->scheduler.ta_op.work_item.event.commit.next_state.ccb_write_offset,
-			 sequence->scheduler.ta_op.work_item.event.commit.next_state.ccb_offset,
-			 sequence->scheduler.ta_op.work_item.event.commit.next_state.queue_packet_count,
-			 !!sequence->scheduler.ta_op.work_item.event.commit.next_state.queue_head_packet_count,
-			 sequence->scheduler.ta_op.work_item.event.commit.next_state.sync_complete_seq,
-			 sequence->scheduler.ta_op.work_item.event.commit.next_state.owner_complete_cookie,
-			 sequence->scheduler.ta_op.work_item.event.commit.next_state.queue_epoch,
-			 sequence->scheduler.next_state.running_ticket,
-			 sequence->scheduler.next_state.complete_ticket);
-	kfree(sequence);
+			 work_queue->sequence.scheduler.ta_op.work_item.event.commit.next_state.ccb_read_offset,
+			 work_queue->sequence.scheduler.ta_op.work_item.event.commit.next_state.ccb_write_offset,
+			 work_queue->sequence.scheduler.ta_op.work_item.event.commit.next_state.ccb_offset,
+			 work_queue->sequence.scheduler.ta_op.work_item.event.commit.next_state.queue_packet_count,
+			 !!work_queue->sequence.scheduler.ta_op.work_item.event.commit.next_state.queue_head_packet_count,
+			 work_queue->sequence.scheduler.ta_op.work_item.event.commit.next_state.sync_complete_seq,
+			 work_queue->sequence.scheduler.ta_op.work_item.event.commit.next_state.owner_complete_cookie,
+			 work_queue->sequence.scheduler.ta_op.work_item.event.commit.next_state.queue_epoch,
+			 work_queue->sequence.scheduler.next_state.running_ticket,
+			 work_queue->sequence.scheduler.next_state.complete_ticket);
+	kfree(work_queue);
 	return ret;
 }
 
 static int poulsbo_sgx_issue_submit(struct drm_device *dev, u32 submit_id,
 				    u32 owner_state, u32 issued_packets)
 {
-	struct psb_sgx_lab_submit_sgx_ta_sequence *sequence = NULL;
+	struct psb_sgx_lab_submit_sgx_ta_work_queue *work_queue = NULL;
 	const struct psb_sgx_lab_submit_sgx_issue_image *issue_image;
 	int ret;
 
-	ret = poulsbo_sgx_execute_submit_sgx_ta_sequence(
+	ret = poulsbo_sgx_execute_submit_sgx_ta_work_queue(
 		dev, submit_id, PSB_SGX_LAB_SUBMIT_SGX_TA_OP_ISSUE,
-		owner_state, issued_packets, &sequence);
+		owner_state, issued_packets, &work_queue);
 	if (ret)
 		goto out;
 
 	issue_image =
-		&sequence->scheduler.ta_op.work_item.event.commit.path.dispatch.issue_image;
+		&work_queue->sequence.scheduler.ta_op.work_item.event.commit.path.dispatch.issue_image;
 
 	if (!ret)
 		dev_info(dev->dev,
@@ -14166,12 +14342,12 @@ static int poulsbo_sgx_issue_submit(struct drm_device *dev, u32 submit_id,
 			 issue_image->sync.pending_seq,
 			 issue_image->owner.owner_issue_cookie,
 			 issue_image->sync.epoch,
-			 sequence->scheduler.ta_op.work_item.event.commit.path.dispatch.schedule.control.issue_request.plan.refilled_from_complete,
-			 sequence->scheduler.next_state.issue_ticket,
-			 sequence->scheduler.next_state.running_ticket);
+			 work_queue->sequence.scheduler.ta_op.work_item.event.commit.path.dispatch.schedule.control.issue_request.plan.refilled_from_complete,
+			 work_queue->sequence.scheduler.next_state.issue_ticket,
+			 work_queue->sequence.scheduler.next_state.running_ticket);
 
 out:
-	kfree(sequence);
+	kfree(work_queue);
 	return ret;
 }
 
-- 
