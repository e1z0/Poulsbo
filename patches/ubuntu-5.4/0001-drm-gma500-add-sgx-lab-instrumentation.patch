From c6bf22f0c04f3371d874519620fb0a9392c9481b Mon Sep 17 00:00:00 2001
From: e1z0 <e1z0@icloud.com>
Date: Sat, 16 May 2026 00:57:33 +0300
Subject: [PATCH] drm/gma500: fold SGX TA request ioctl into request terminal

---
 drivers/gpu/drm/gma500/psb_drv.c | 86 +++++---------------------------
 1 file changed, 13 insertions(+), 73 deletions(-)

diff --git a/drivers/gpu/drm/gma500/psb_drv.c b/drivers/gpu/drm/gma500/psb_drv.c
index af2aeeabf..2748d06aa 100644
--- a/drivers/gpu/drm/gma500/psb_drv.c
+++ b/drivers/gpu/drm/gma500/psb_drv.c
@@ -2880,20 +2880,6 @@ struct psb_sgx_lab_submit_sgx_ta_submit_op_request_terminal {
 	u32 request_terminal_op;
 };
 
-struct psb_sgx_lab_submit_sgx_ta_submit_op_request_ioctl {
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_terminal
-		submit_op_request_terminal;
-	struct drm_psb_sgx_lab_submit_op request_op;
-	struct drm_psb_sgx_lab_submit_op response_op;
-	struct psb_sgx_lab_submit_sgx_ta_request_work_outcome outcome;
-	bool active;
-	bool dependency_fields_present;
-	bool issue_request_ioctl;
-	bool transition_request_ioctl;
-	u32 resolved_submit_id;
-	u32 request_ioctl_op;
-};
-
 static u32 poulsbo_sgx_lab_status_value(u32 seed, bool is_3d, u32 index);
 static int poulsbo_sgx_queue_region_end(u32 base_offset, u32 queue_size,
 					u32 *end_out);
@@ -19824,52 +19810,6 @@ out_free_terminal:
 	return ret;
 }
 
-static int poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_ioctl(
-	struct drm_device *dev,
-	const struct drm_psb_sgx_lab_submit_op *op,
-	bool dependency_fields_present,
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_ioctl **return_out)
-{
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_terminal *terminal =
-		NULL;
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_ioctl *ioctl;
-	int ret;
-
-	if (!dev || !op || !return_out)
-		return -EINVAL;
-
-	*return_out = NULL;
-	ioctl = kmalloc(sizeof(*ioctl), GFP_KERNEL);
-	if (!ioctl)
-		return -ENOMEM;
-
-	ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_terminal(
-		dev, op, dependency_fields_present, &terminal);
-	if (ret)
-		goto out_free_ioctl;
-
-	ioctl->submit_op_request_terminal = *terminal;
-	ioctl->request_op = terminal->request_op;
-	ioctl->response_op = terminal->response_op;
-	ioctl->outcome = terminal->outcome;
-	ioctl->active = terminal->active;
-	ioctl->dependency_fields_present =
-		terminal->dependency_fields_present;
-	ioctl->issue_request_ioctl = terminal->issue_request_terminal;
-	ioctl->transition_request_ioctl =
-		terminal->transition_request_terminal;
-	ioctl->resolved_submit_id = terminal->resolved_submit_id;
-	ioctl->request_ioctl_op = op->op;
-
-	kfree(terminal);
-	*return_out = ioctl;
-	return 0;
-
-out_free_ioctl:
-	kfree(ioctl);
-	return ret;
-}
-
 static int poulsbo_sgx_prepare_queue_packets_locked(
 	struct psb_sgx_lab_object *control_obj,
 	struct psb_sgx_lab_submit *submit,
@@ -25991,7 +25931,7 @@ static int psb_ioctl_sgx_lab_submit_op(struct drm_device *dev, void *data,
 {
 	struct drm_psb_private *dev_priv = dev->dev_private;
 	struct drm_psb_sgx_lab_submit_op *op = data;
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_ioctl *request_ioctl =
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_terminal *request_terminal =
 		NULL;
 	const char *slot_name = NULL;
 	bool dependency_fields_present;
@@ -26242,16 +26182,16 @@ static int psb_ioctl_sgx_lab_submit_op(struct drm_device *dev, void *data,
 						op->packet_count);
 		break;
 	case DRM_PSB_SGX_LAB_SUBMIT_OP_ISSUE:
-		ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_ioctl(
-			dev, op, dependency_fields_present, &request_ioctl);
+		ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_terminal(
+			dev, op, dependency_fields_present, &request_terminal);
 		if (!ret)
-			submit_id = request_ioctl->response_op.resolved_submit_id;
+			submit_id = request_terminal->response_op.resolved_submit_id;
 		break;
 	case DRM_PSB_SGX_LAB_SUBMIT_OP_TRANSITION:
-		ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_ioctl(
-			dev, op, dependency_fields_present, &request_ioctl);
+		ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_terminal(
+			dev, op, dependency_fields_present, &request_terminal);
 		if (!ret)
-			submit_id = request_ioctl->response_op.resolved_submit_id;
+			submit_id = request_terminal->response_op.resolved_submit_id;
 		break;
 	case DRM_PSB_SGX_LAB_SUBMIT_OP_ATTACH:
 		if (op->owner_state || op->packet_count || op->context ||
@@ -26692,17 +26632,17 @@ static int psb_ioctl_sgx_lab_submit_op(struct drm_device *dev, void *data,
 		return -EINVAL;
 	}
 	if (ret)
-		goto out_free_request_ioctl;
-	if (request_ioctl) {
-		kfree(request_ioctl);
-		request_ioctl = NULL;
+		goto out_free_request_terminal;
+	if (request_terminal) {
+		kfree(request_terminal);
+		request_terminal = NULL;
 	}
 
 	op->resolved_submit_id = submit_id;
 	return 0;
 
-out_free_request_ioctl:
-	kfree(request_ioctl);
+out_free_request_terminal:
+	kfree(request_terminal);
 	return ret;
 }
 
-- 
2.34.1

