From 1923cd6b78d77c8bf740248716db66d8c438fdad Mon Sep 17 00:00:00 2001
From: e1z0 <e1z0@icloud.com>
Date: Sat, 16 May 2026 00:18:19 +0300
Subject: [PATCH] drm/gma500: fold SGX TA request alias into request bridge

---
 drivers/gpu/drm/gma500/psb_drv.c | 183 +++++++++++--------------------
 1 file changed, 62 insertions(+), 121 deletions(-)

diff --git a/drivers/gpu/drm/gma500/psb_drv.c b/drivers/gpu/drm/gma500/psb_drv.c
index 7e92a45ef..af2aeeabf 100644
--- a/drivers/gpu/drm/gma500/psb_drv.c
+++ b/drivers/gpu/drm/gma500/psb_drv.c
@@ -2880,20 +2880,6 @@ struct psb_sgx_lab_submit_sgx_ta_submit_op_request_terminal {
 	u32 request_terminal_op;
 };
 
-struct psb_sgx_lab_submit_sgx_ta_submit_op_request_alias {
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_bridge
-		submit_op_request_bridge;
-	struct drm_psb_sgx_lab_submit_op request_op;
-	struct drm_psb_sgx_lab_submit_op response_op;
-	struct psb_sgx_lab_submit_sgx_ta_request_work_outcome outcome;
-	bool active;
-	bool dependency_fields_present;
-	bool issue_request_alias;
-	bool transition_request_alias;
-	u32 resolved_submit_id;
-	u32 request_alias_op;
-};
-
 struct psb_sgx_lab_submit_sgx_ta_submit_op_request_ioctl {
 	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_terminal
 		submit_op_request_terminal;
@@ -19838,103 +19824,6 @@ out_free_terminal:
 	return ret;
 }
 
-static int poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_alias(
-	struct drm_device *dev,
-	const struct drm_psb_sgx_lab_submit_op *op,
-	bool dependency_fields_present,
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_alias **return_out)
-{
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_bridge *bridge = NULL;
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_alias *alias;
-	int ret;
-
-	if (!dev || !op || !return_out)
-		return -EINVAL;
-
-	*return_out = NULL;
-	alias = kmalloc(sizeof(*alias), GFP_KERNEL);
-	if (!alias)
-		return -ENOMEM;
-
-	ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_bridge(
-		dev, op, dependency_fields_present, &bridge);
-	if (ret)
-		goto out_free_alias;
-
-	alias->submit_op_request_bridge = *bridge;
-	alias->request_op = bridge->request_op;
-	alias->response_op = bridge->response_op;
-	alias->outcome = bridge->outcome;
-	alias->active = bridge->active;
-	alias->dependency_fields_present =
-		bridge->dependency_fields_present;
-	alias->issue_request_alias = bridge->issue_request_bridge;
-	alias->transition_request_alias =
-		bridge->transition_request_bridge;
-	alias->resolved_submit_id = bridge->resolved_submit_id;
-	alias->request_alias_op = op->op;
-
-	if (op->op == DRM_PSB_SGX_LAB_SUBMIT_OP_TRANSITION) {
-		const struct psb_sgx_lab_submit_sgx_ta_request_work_outcome
-			*outcome = &alias->outcome;
-
-		dev_info(dev->dev,
-			 "lab submit transition submit_id=%u state=%s completed_packets=%u new_read_offset=%#x new_write_offset=%#x new_ccb_offset=%#x outstanding=%u wrapped=%u complete_seq=%#x complete_cookie=%#x epoch=%u global_running_ticket=%u global_complete_ticket=%u refresh_views=%u next_transition_count=%u running_advanced=%u complete_advanced=%u next_running_ticket=%u next_complete_ticket=%u active_running_changed=%u\n",
-			 outcome->submit_id,
-			 poulsbo_sgx_lab_owner_state_name(outcome->owner_state),
-			 outcome->packet_count,
-			 outcome->selected_read_offset,
-			 outcome->selected_write_offset,
-			 outcome->selected_ccb_offset,
-			 outcome->selected_outstanding_packets,
-			 outcome->selected_wrapped,
-			 outcome->selected_seq,
-			 outcome->selected_cookie,
-			 outcome->epoch,
-			 outcome->global_running_ticket,
-			 outcome->global_complete_ticket,
-			 outcome->refresh_views,
-			 outcome->next_transition_count,
-			 outcome->running_advanced,
-			 outcome->complete_advanced,
-			 outcome->next_state.running_ticket,
-			 outcome->next_state.complete_ticket,
-			 outcome->active_running_changed);
-	} else if (op->op == DRM_PSB_SGX_LAB_SUBMIT_OP_ISSUE) {
-		const struct psb_sgx_lab_submit_sgx_ta_request_work_outcome
-			*outcome = &alias->outcome;
-
-		dev_info(dev->dev,
-			 "lab submit issue submit_id=%u state=%s issued_packets=%u read_offset=%#x new_write_offset=%#x outstanding=%u wrapped=%u pending_seq=%#x issue_cookie=%#x epoch=%u refill=%u global_issue_ticket=%u global_running_ticket=%u refresh_views=%u next_issue_count=%u issue_advanced=%u next_issue_ticket=%u next_issue_submit_id=%u\n",
-			 outcome->submit_id,
-			 poulsbo_sgx_lab_owner_state_name(outcome->owner_state),
-			 outcome->packet_count,
-			 outcome->selected_read_offset,
-			 outcome->selected_write_offset,
-			 outcome->selected_outstanding_packets,
-			 outcome->selected_wrapped,
-			 outcome->selected_seq,
-			 outcome->selected_cookie,
-			 outcome->epoch,
-			 outcome->refilled_from_complete,
-			 outcome->global_issue_ticket,
-			 outcome->global_running_ticket,
-			 outcome->refresh_views,
-			 outcome->next_issue_count,
-			 outcome->issue_advanced,
-			 outcome->next_state.issue_ticket,
-			 outcome->next_state.issue_submit_id);
-	}
-
-	kfree(bridge);
-	*return_out = alias;
-	return 0;
-
-out_free_alias:
-	kfree(alias);
-	return ret;
-}
-
 static int poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_ioctl(
 	struct drm_device *dev,
 	const struct drm_psb_sgx_lab_submit_op *op,
@@ -23833,8 +23722,8 @@ static ssize_t poulsbo_sgx_submit_store(struct device *kdev,
 								  owner_offset);
 	} else if (sysfs_streq(op, "issue")) {
 		struct drm_psb_sgx_lab_submit_op request_op = {};
-		struct psb_sgx_lab_submit_sgx_ta_submit_op_request_alias
-			*alias = NULL;
+		struct psb_sgx_lab_submit_sgx_ta_submit_op_request_bridge
+			*bridge = NULL;
 
 			if (sscanf(buf, "%15s %u %15s %15s",
 				   op, &id, arg0, arg1) != 4)
@@ -23849,13 +23738,38 @@ static ssize_t poulsbo_sgx_submit_store(struct device *kdev,
 		request_op.submit_id = id;
 		request_op.owner_state = issue_owner_state;
 		request_op.packet_count = issue_issued_packets;
-		ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_alias(
-			dev, &request_op, false, &alias);
-		kfree(alias);
+		ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_bridge(
+			dev, &request_op, false, &bridge);
+		if (!ret && bridge) {
+			const struct psb_sgx_lab_submit_sgx_ta_request_work_outcome
+				*outcome = &bridge->outcome;
+
+			dev_info(dev->dev,
+				 "lab submit issue submit_id=%u state=%s issued_packets=%u read_offset=%#x new_write_offset=%#x outstanding=%u wrapped=%u pending_seq=%#x issue_cookie=%#x epoch=%u refill=%u global_issue_ticket=%u global_running_ticket=%u refresh_views=%u next_issue_count=%u issue_advanced=%u next_issue_ticket=%u next_issue_submit_id=%u\n",
+				 outcome->submit_id,
+				 poulsbo_sgx_lab_owner_state_name(outcome->owner_state),
+				 outcome->packet_count,
+				 outcome->selected_read_offset,
+				 outcome->selected_write_offset,
+				 outcome->selected_outstanding_packets,
+				 outcome->selected_wrapped,
+				 outcome->selected_seq,
+				 outcome->selected_cookie,
+				 outcome->epoch,
+				 outcome->refilled_from_complete,
+				 outcome->global_issue_ticket,
+				 outcome->global_running_ticket,
+				 outcome->refresh_views,
+				 outcome->next_issue_count,
+				 outcome->issue_advanced,
+				 outcome->next_state.issue_ticket,
+				 outcome->next_state.issue_submit_id);
+		}
+		kfree(bridge);
 	} else if (sysfs_streq(op, "transition")) {
 		struct drm_psb_sgx_lab_submit_op request_op = {};
-		struct psb_sgx_lab_submit_sgx_ta_submit_op_request_alias
-			*alias = NULL;
+		struct psb_sgx_lab_submit_sgx_ta_submit_op_request_bridge
+			*bridge = NULL;
 
 		if (sscanf(buf, "%15s %u %15s %15s",
 			   op, &id, arg0, arg1) != 4)
@@ -23871,9 +23785,36 @@ static ssize_t poulsbo_sgx_submit_store(struct device *kdev,
 		request_op.submit_id = id;
 		request_op.owner_state = transition_owner_state;
 		request_op.packet_count = transition_completed_packets;
-		ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_alias(
-			dev, &request_op, false, &alias);
-		kfree(alias);
+		ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_bridge(
+			dev, &request_op, false, &bridge);
+		if (!ret && bridge) {
+			const struct psb_sgx_lab_submit_sgx_ta_request_work_outcome
+				*outcome = &bridge->outcome;
+
+			dev_info(dev->dev,
+				 "lab submit transition submit_id=%u state=%s completed_packets=%u new_read_offset=%#x new_write_offset=%#x new_ccb_offset=%#x outstanding=%u wrapped=%u complete_seq=%#x complete_cookie=%#x epoch=%u global_running_ticket=%u global_complete_ticket=%u refresh_views=%u next_transition_count=%u running_advanced=%u complete_advanced=%u next_running_ticket=%u next_complete_ticket=%u active_running_changed=%u\n",
+				 outcome->submit_id,
+				 poulsbo_sgx_lab_owner_state_name(outcome->owner_state),
+				 outcome->packet_count,
+				 outcome->selected_read_offset,
+				 outcome->selected_write_offset,
+				 outcome->selected_ccb_offset,
+				 outcome->selected_outstanding_packets,
+				 outcome->selected_wrapped,
+				 outcome->selected_seq,
+				 outcome->selected_cookie,
+				 outcome->epoch,
+				 outcome->global_running_ticket,
+				 outcome->global_complete_ticket,
+				 outcome->refresh_views,
+				 outcome->next_transition_count,
+				 outcome->running_advanced,
+				 outcome->complete_advanced,
+				 outcome->next_state.running_ticket,
+				 outcome->next_state.complete_ticket,
+				 outcome->active_running_changed);
+		}
+		kfree(bridge);
 	} else if (sysfs_streq(op, "focus")) {
 		if (sscanf(buf, "%15s %15s", op, arg0) != 2)
 			return -EINVAL;
-- 
2.34.1

