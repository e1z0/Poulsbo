-	ret = poulsbo_sgx_owner_region_end(submit->launch_owner_offset,
-					   &owner_region_end);
-	if (ret)
-		goto out_unlock;
+	issue_image = &dispatch->issue_image;
 
 	control_obj = poulsbo_sgx_find_object_locked(dev_priv,
 						     submit->launch_control_object_id);
@@ -12630,38 +12882,25 @@ static int poulsbo_sgx_issue_submit(struct drm_device *dev, u32 submit_id,
 		ret = -ENOENT;
 		goto out_unlock;
 	}
-	if (queue_region_end > control_obj->gt->gem.size) {
+	if (issue_image->queue_region_end > control_obj->gt->gem.size) {
 		ret = -EINVAL;
 		goto out_unlock;
 	}
 	ret = poulsbo_sgx_object_access_ok(control_obj, 0, 32);
 	if (ret)
 		goto out_unlock;
-	launch_pds_gpu_va32 = (u32)submit->launch_pds_gpu_va;
-	launch_use_gpu_va32 = (u32)submit->launch_use_gpu_va;
-	launch_target_gpu_va32 = (u32)submit->launch_target_gpu_va;
-	launch_status_gpu_va32 = (u32)submit->launch_status_gpu_va;
 	ret = poulsbo_sgx_object_access_ok(status_obj, submit->launch_sync_offset,
-					   sync_region_end -
+					   issue_image->sync_region_end -
