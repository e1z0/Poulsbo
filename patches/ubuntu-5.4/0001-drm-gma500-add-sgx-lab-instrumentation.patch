-	queue_header.queue_base_offset = submit->queue_base_offset;
-	queue_header.queue_size = submit->queue_size;
-	queue_header.queue_packet_size = submit->queue_packet_size;
-	queue_header.queue_packet_count = new_packet_count;
-	queue_header.queue_tail_packet_count = new_tail_packets;
-	queue_header.queue_head_packet_count = new_head_packets;
-	ret = poulsbo_sgx_write_queue_header_locked(control_obj, 0,
-						    &queue_header);
+	ret = poulsbo_sgx_write_queue_header_locked(
+		control_obj, 0, &transition_image->queue_header);
 	if (ret)
 		goto out_unlock;
-	memset(&ccb_record, 0, sizeof(ccb_record));
-	ccb_record.service_address = submit->ccb_service_address;
-	ccb_record.cache_control = submit->ccb_cache_control;
-	ccb_record.data0 = submit->ccb_data0;
-	ccb_record.data1 = submit->ccb_data1;
-	ccb_record.pds_gpu_va32 =
-		(u32)poulsbo_sgx_object_gpu_va(dev_priv, pds_obj);
-	ccb_record.use_gpu_va32 =
