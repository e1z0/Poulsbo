 	}
 
@@ -4833,28 +4850,7 @@ static int poulsbo_sgx_apply_submit_sgx_ta_commit_locked(
 	poulsbo_sgx_update_dispatch_submit_locked(
 		submit, commit->next_state.owner_state,
