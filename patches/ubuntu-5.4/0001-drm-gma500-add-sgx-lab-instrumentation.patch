+		    ccb_kick->cmdta.issue_plan.owner_state ||
+	    queued_ta_command->issue_plan.issued_packets !=
+		    ccb_kick->cmdta.issue_plan.issued_packets ||
+	    queued_ta_command->issue_plan.refilled_from_complete !=
