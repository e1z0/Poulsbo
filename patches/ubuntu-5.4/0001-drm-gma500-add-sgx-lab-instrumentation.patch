From db74c48a672632ca497820304887a611affa735c Mon Sep 17 00:00:00 2001
From: e1z0 <e1z0@icloud.com>
Date: Fri, 15 May 2026 15:43:38 +0300
Subject: [PATCH] drm/gma500: add SGX TA submit-op request ioctl

---
 drivers/gpu/drm/gma500/psb_drv.c | 85 +++++++++++++++++++++++++++-----
 1 file changed, 72 insertions(+), 13 deletions(-)

diff --git a/drivers/gpu/drm/gma500/psb_drv.c b/drivers/gpu/drm/gma500/psb_drv.c
index 108dd8bb5..af00800b5 100644
--- a/drivers/gpu/drm/gma500/psb_drv.c
+++ b/drivers/gpu/drm/gma500/psb_drv.c
@@ -2922,6 +2922,20 @@ struct psb_sgx_lab_submit_sgx_ta_submit_op_request_public {
 	u32 request_public_op;
 };
 
+struct psb_sgx_lab_submit_sgx_ta_submit_op_request_ioctl {
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_public
+		submit_op_request_public;
+	struct drm_psb_sgx_lab_submit_op request_op;
+	struct drm_psb_sgx_lab_submit_op response_op;
+	struct psb_sgx_lab_submit_sgx_ta_request_work_outcome outcome;
+	bool active;
+	bool dependency_fields_present;
+	bool issue_request_ioctl;
+	bool transition_request_ioctl;
+	u32 resolved_submit_id;
+	u32 request_ioctl_op;
+};
+
 static u32 poulsbo_sgx_lab_status_value(u32 seed, bool is_3d, u32 index);
 static int poulsbo_sgx_queue_region_end(u32 base_offset, u32 queue_size,
 					u32 *end_out);
@@ -20041,6 +20055,51 @@ out_free_public:
 	return ret;
 }
 
+static int poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_ioctl(
+	struct drm_device *dev,
+	const struct drm_psb_sgx_lab_submit_op *op,
+	bool dependency_fields_present,
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_ioctl **return_out)
+{
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_public *public = NULL;
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_ioctl *ioctl;
+	int ret;
+
+	if (!dev || !op || !return_out)
+		return -EINVAL;
+
+	*return_out = NULL;
+	ioctl = kmalloc(sizeof(*ioctl), GFP_KERNEL);
+	if (!ioctl)
+		return -ENOMEM;
+
+	ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_public(
+		dev, op, dependency_fields_present, &public);
+	if (ret)
+		goto out_free_ioctl;
+
+	ioctl->submit_op_request_public = *public;
+	ioctl->request_op = public->request_op;
+	ioctl->response_op = public->response_op;
+	ioctl->outcome = public->outcome;
+	ioctl->active = public->active;
+	ioctl->dependency_fields_present =
+		public->dependency_fields_present;
+	ioctl->issue_request_ioctl = public->issue_request_public;
+	ioctl->transition_request_ioctl =
+		public->transition_request_public;
+	ioctl->resolved_submit_id = public->resolved_submit_id;
+	ioctl->request_ioctl_op = op->op;
+
+	kfree(public);
+	*return_out = ioctl;
+	return 0;
+
+out_free_ioctl:
+	kfree(ioctl);
+	return ret;
+}
+
 static int poulsbo_sgx_prepare_queue_packets_locked(
 	struct psb_sgx_lab_object *control_obj,
 	struct psb_sgx_lab_submit *submit,
@@ -26131,7 +26190,7 @@ static int psb_ioctl_sgx_lab_submit_op(struct drm_device *dev, void *data,
 {
 	struct drm_psb_private *dev_priv = dev->dev_private;
 	struct drm_psb_sgx_lab_submit_op *op = data;
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_public *public =
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_ioctl *ioctl =
 		NULL;
 	const char *slot_name = NULL;
 	bool dependency_fields_present;
@@ -26382,16 +26441,16 @@ static int psb_ioctl_sgx_lab_submit_op(struct drm_device *dev, void *data,
 						op->packet_count);
 		break;
 	case DRM_PSB_SGX_LAB_SUBMIT_OP_ISSUE:
-		ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_public(
-			dev, op, dependency_fields_present, &public);
+		ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_ioctl(
+			dev, op, dependency_fields_present, &ioctl);
 		if (!ret)
-			submit_id = public->response_op.resolved_submit_id;
+			submit_id = ioctl->response_op.resolved_submit_id;
 		break;
 	case DRM_PSB_SGX_LAB_SUBMIT_OP_TRANSITION:
-		ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_public(
-			dev, op, dependency_fields_present, &public);
+		ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_ioctl(
+			dev, op, dependency_fields_present, &ioctl);
 		if (!ret)
-			submit_id = public->response_op.resolved_submit_id;
+			submit_id = ioctl->response_op.resolved_submit_id;
 		break;
 	case DRM_PSB_SGX_LAB_SUBMIT_OP_ATTACH:
 		if (op->owner_state || op->packet_count || op->context ||
@@ -26832,17 +26891,17 @@ static int psb_ioctl_sgx_lab_submit_op(struct drm_device *dev, void *data,
 		return -EINVAL;
 	}
 	if (ret)
-		goto out_free_public;
-	if (public) {
-		kfree(public);
-		public = NULL;
+		goto out_free_ioctl;
+	if (ioctl) {
+		kfree(ioctl);
+		ioctl = NULL;
 	}
 
 	op->resolved_submit_id = submit_id;
 	return 0;
 
-out_free_public:
-	kfree(public);
+out_free_ioctl:
+	kfree(ioctl);
 	return ret;
 }
 
-- 
2.34.1

