+static int poulsbo_sgx_build_submit_queue_header_locked(
+	struct psb_sgx_lab_submit *submit,
+	struct psb_sgx_lab_queue_header_words *queue_header)
+{
+	struct psb_sgx_lab_submit_exec_record record;
+	u32 expected_tail_packets;
+	u32 expected_head_packets;
+	u32 expected_write_offset;
+	int ret;
+
+	if (!queue_header)
+		return -EINVAL;
+
+	ret = poulsbo_sgx_build_submit_exec_record_locked(
+		NULL, submit, PSB_SGX_LAB_EXEC_SOURCE_LIVE, &record);
+	if (ret)
+		return ret;
+	expected_tail_packets = 0;
+	expected_head_packets = 0;
+	expected_write_offset = record.ccb_write_offset;
+	if (record.queue_size && record.queue_packet_size &&
+	    record.queue_packet_count) {
+		ret = poulsbo_sgx_queue_progression(record.ccb_read_offset,
+						    record.queue_size,
+						    record.queue_packet_size,
+						    record.queue_packet_count,
+						    &expected_tail_packets,
+						    &expected_head_packets,
+						    &expected_write_offset);
+		if (ret)
+			return ret;
+		if (expected_write_offset != record.ccb_write_offset)
+			return -EINVAL;
+	}
+
+	memset(queue_header, 0, sizeof(*queue_header));
+	queue_header->write_offset = record.ccb_write_offset;
+	queue_header->read_offset = record.ccb_read_offset;
+	queue_header->queue_base_offset = record.queue_base_offset;
+	queue_header->queue_size = record.queue_size;
+	queue_header->queue_packet_size = record.queue_packet_size;
+	queue_header->queue_packet_count = record.queue_packet_count;
+	queue_header->queue_tail_packet_count = expected_tail_packets;
+	queue_header->queue_head_packet_count = expected_head_packets;
+	return 0;
+}
