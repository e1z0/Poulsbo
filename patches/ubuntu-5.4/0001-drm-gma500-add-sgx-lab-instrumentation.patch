+static void
+psb_sgx_format_bits(const struct psb_irq_bit_name *bits, size_t bit_count,
+		    u32 value, char *buf, size_t buf_size)
+{
+	size_t pos = 0;
+	bool first = true;
+	unsigned int i;
+
+	if (!buf_size)
+		return;
+
+	buf[0] = '\0';
+
+	for (i = 0; i < bit_count; i++) {
+		if (!(value & bits[i].bit))
+			continue;
+		if (pos >= buf_size)
+			break;
+		pos += scnprintf(buf + pos, buf_size - pos, "%s%s",
+				 first ? "" : ",", bits[i].name);
+		first = false;
+	}
+
+	if (first)
+		scnprintf(buf, buf_size, "none");
+}
