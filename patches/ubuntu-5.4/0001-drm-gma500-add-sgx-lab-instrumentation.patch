+			 !!sequence->scheduler.ta_op.work_item.event.commit.next_state.queue_head_packet_count,
+			 sequence->scheduler.ta_op.work_item.event.commit.next_state.sync_complete_seq,
+			 sequence->scheduler.ta_op.work_item.event.commit.next_state.owner_complete_cookie,
+			 sequence->scheduler.ta_op.work_item.event.commit.next_state.queue_epoch,
+			 sequence->scheduler.next_state.running_ticket,
+			 sequence->scheduler.next_state.complete_ticket);
+	kfree(sequence);
 	return ret;
