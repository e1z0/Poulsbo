From c6b341f3adab57f3777a8add3aa802a288e5760e Mon Sep 17 00:00:00 2001
From: e1z0 <e1z0@icloud.com>
Date: Wed, 13 May 2026 18:28:43 +0300
Subject: [PATCH] drm/gma500: add SGX TA event object

---
 drivers/gpu/drm/gma500/psb_drv.c | 208 +++++++++++++++++++++++--------
 1 file changed, 156 insertions(+), 52 deletions(-)

diff --git a/drivers/gpu/drm/gma500/psb_drv.c b/drivers/gpu/drm/gma500/psb_drv.c
index 8d61f8b5d..ed08b0eb8 100644
--- a/drivers/gpu/drm/gma500/psb_drv.c
+++ b/drivers/gpu/drm/gma500/psb_drv.c
@@ -1548,6 +1548,16 @@ struct psb_sgx_lab_submit_sgx_ta_commit {
 	struct psb_sgx_lab_submit_sgx_ta_commit_state next_state;
 };
 
+struct psb_sgx_lab_submit_sgx_ta_event {
+	struct psb_sgx_lab_submit_sgx_ta_commit commit;
+	bool refresh_views;
+	bool increment_issue_count;
+	bool increment_transition_count;
+	bool update_last_epoch_jiffies;
+	bool update_last_issue_jiffies;
+	bool update_last_transition_jiffies;
+};
+
 static u32 poulsbo_sgx_lab_status_value(u32 seed, bool is_3d, u32 index);
 static int poulsbo_sgx_queue_region_end(u32 base_offset, u32 queue_size,
 					u32 *end_out);
@@ -1623,6 +1633,9 @@ static void
 poulsbo_sgx_update_dispatch_submit_locked(struct psb_sgx_lab_submit *submit,
 					  u32 owner_state,
 					  u32 completed_packets);
+static int poulsbo_sgx_refresh_submit_views_locked(
+	struct drm_psb_private *dev_priv,
+	struct psb_sgx_lab_submit *submit);
 static int poulsbo_sgx_refresh_dependency_dependents_locked(
 	struct drm_psb_private *dev_priv,
 	u32 completed_submit_id);
@@ -4825,6 +4838,90 @@ static int poulsbo_sgx_apply_submit_sgx_ta_commit_locked(
 	return 0;
 }
 
+static int poulsbo_sgx_build_submit_sgx_ta_event_locked(
+	struct drm_psb_private *dev_priv,
+	struct psb_sgx_lab_submit *submit,
+	bool have_issue_request,
+	u32 issue_owner_state,
+	u32 issued_packets,
+	bool have_transition_request,
+	u32 transition_owner_state,
+	u32 completed_packets,
+	struct psb_sgx_lab_submit_sgx_ta_event *event)
+{
+	int ret;
+
+	if (!dev_priv || !submit || !event)
+		return -EINVAL;
+	if (have_issue_request && have_transition_request)
+		return -EINVAL;
+
+	memset(event, 0, sizeof(*event));
+
+	ret = poulsbo_sgx_build_submit_sgx_ta_commit_locked(
+		dev_priv, submit, have_issue_request, issue_owner_state,
+		issued_packets, have_transition_request, transition_owner_state,
+		completed_packets, &event->commit);
+	if (ret)
+		return ret;
+
+	if (have_issue_request) {
+		ret = poulsbo_sgx_submit_sgx_ta_commit_issue_status_locked(
+			&event->commit);
+		if (ret)
+			return ret;
+		event->refresh_views = true;
+		event->increment_issue_count = true;
+		event->update_last_epoch_jiffies =
+			submit->launch_refilled_from_complete;
+		event->update_last_issue_jiffies = true;
+		return 0;
+	}
+
+	if (!have_transition_request)
+		return 0;
+
+	ret = poulsbo_sgx_submit_sgx_ta_commit_transition_status_locked(
+		&event->commit);
+	if (ret)
+		return ret;
+	event->refresh_views = true;
+	event->increment_transition_count = true;
+	event->update_last_transition_jiffies = true;
+	return 0;
+}
+
+static int poulsbo_sgx_apply_submit_sgx_ta_event_locked(
+	struct drm_psb_private *dev_priv,
+	struct psb_sgx_lab_submit *submit,
+	const struct psb_sgx_lab_submit_sgx_ta_event *event)
+{
+	int ret;
+
+	if (!dev_priv || !submit || !event)
+		return -EINVAL;
+
+	ret = poulsbo_sgx_apply_submit_sgx_ta_commit_locked(
+		dev_priv, submit, &event->commit);
+	if (ret)
+		return ret;
+
+	if (event->increment_issue_count)
+		submit->issue_count++;
+	if (event->increment_transition_count)
+		submit->transition_count++;
+	if (event->update_last_epoch_jiffies)
+		submit->last_epoch_jiffies = jiffies;
+	if (event->update_last_issue_jiffies)
+		submit->last_issue_jiffies = jiffies;
+	if (event->update_last_transition_jiffies)
+		submit->last_transition_jiffies = jiffies;
+	if (!event->refresh_views)
+		return 0;
+
+	return poulsbo_sgx_refresh_submit_views_locked(dev_priv, submit);
+}
+
 static int poulsbo_sgx_collect_submit_view_records_locked(
 	struct drm_psb_private *dev_priv,
 	struct psb_sgx_lab_submit *submit,
@@ -10484,17 +10581,39 @@ static int poulsbo_sgx_validate_built_submit_sgx_ta_commit_locked(
 	return (commit->issue_active || commit->transition_active) ? -EINVAL : 0;
 }
 
-static int poulsbo_sgx_validate_submit_sgx_ta_commit_locked(
+static int poulsbo_sgx_validate_built_submit_sgx_ta_event_locked(
+	struct drm_psb_private *dev_priv,
+	struct psb_sgx_lab_submit *submit,
+	const struct psb_sgx_lab_submit_sgx_ta_event *event)
+{
+	int ret;
+
+	if (!dev_priv || !submit || !event)
+		return -EINVAL;
+
+	ret = poulsbo_sgx_validate_built_submit_sgx_ta_commit_locked(
+		dev_priv, submit, &event->commit);
+	if (ret)
+		return ret;
+
+	return (event->refresh_views || event->increment_issue_count ||
+		event->increment_transition_count ||
+		event->update_last_epoch_jiffies ||
+		event->update_last_issue_jiffies ||
+		event->update_last_transition_jiffies) ? -EINVAL : 0;
+}
+
+static int poulsbo_sgx_validate_submit_sgx_ta_event_locked(
 	struct drm_psb_private *dev_priv,
 	struct psb_sgx_lab_submit *submit,
 	struct psb_sgx_lab_object *control_obj,
 	struct psb_sgx_lab_object *status_obj)
 {
-	struct psb_sgx_lab_submit_sgx_ta_commit *commit;
+	struct psb_sgx_lab_submit_sgx_ta_event *event;
 	int ret;
 
-	commit = kmalloc(sizeof(*commit), GFP_KERNEL);
-	if (!commit)
+	event = kmalloc(sizeof(*event), GFP_KERNEL);
+	if (!event)
 		return -ENOMEM;
 
 	ret = poulsbo_sgx_validate_submit_sgx_ta_dispatch_locked(
@@ -10502,16 +10621,16 @@ static int poulsbo_sgx_validate_submit_sgx_ta_commit_locked(
 	if (ret)
 		goto out;
 
-	ret = poulsbo_sgx_build_submit_sgx_ta_commit_locked(
-		dev_priv, submit, false, 0, 0, false, 0, 0, commit);
+	ret = poulsbo_sgx_build_submit_sgx_ta_event_locked(
+		dev_priv, submit, false, 0, 0, false, 0, 0, event);
 	if (ret)
 		goto out;
 
-	ret = poulsbo_sgx_validate_built_submit_sgx_ta_commit_locked(
-		dev_priv, submit, commit);
+	ret = poulsbo_sgx_validate_built_submit_sgx_ta_event_locked(
+		dev_priv, submit, event);
 
 out:
-	kfree(commit);
+	kfree(event);
 	return ret;
 }
 
@@ -10726,7 +10845,7 @@ static int poulsbo_sgx_validate_submit_locked(struct drm_psb_private *dev_priv,
 		submit, status_obj, NULL);
 	if (ret)
 		return ret;
-	return poulsbo_sgx_validate_submit_sgx_ta_commit_locked(
+	return poulsbo_sgx_validate_submit_sgx_ta_event_locked(
 		dev_priv, submit, control_obj, status_obj);
 }
 
@@ -13214,7 +13333,7 @@ static int poulsbo_sgx_transition_submit(struct drm_device *dev,
 {
 	struct drm_psb_private *dev_priv = dev->dev_private;
 	struct psb_sgx_lab_submit *submit;
-	struct psb_sgx_lab_submit_sgx_ta_commit *commit = NULL;
+	struct psb_sgx_lab_submit_sgx_ta_event *event = NULL;
 	int ret;
 
 	mutex_lock(&dev_priv->sgx_lab_submit_mutex);
@@ -13243,27 +13362,19 @@ static int poulsbo_sgx_transition_submit(struct drm_device *dev,
 		goto out_unlock;
 	}
 
-	commit = kmalloc(sizeof(*commit), GFP_KERNEL);
-	if (!commit) {
+	event = kmalloc(sizeof(*event), GFP_KERNEL);
+	if (!event) {
 		ret = -ENOMEM;
 		goto out_unlock;
 	}
 
-	ret = poulsbo_sgx_build_submit_sgx_ta_commit_locked(
+	ret = poulsbo_sgx_build_submit_sgx_ta_event_locked(
 		dev_priv, submit, false, 0, 0, true, owner_state,
-		completed_packets, commit);
-	if (ret)
-		goto out_unlock;
-	ret = poulsbo_sgx_submit_sgx_ta_commit_transition_status_locked(commit);
-	if (ret)
-		goto out_unlock;
-	ret = poulsbo_sgx_apply_submit_sgx_ta_commit_locked(
-		dev_priv, submit, commit);
+		completed_packets, event);
 	if (ret)
 		goto out_unlock;
-	submit->transition_count++;
-	submit->last_transition_jiffies = jiffies;
-	ret = poulsbo_sgx_refresh_submit_views_locked(dev_priv, submit);
+	ret = poulsbo_sgx_apply_submit_sgx_ta_event_locked(
+		dev_priv, submit, event);
 
 out_unlock:
 	mutex_unlock(&dev_priv->gtt_mutex);
@@ -13275,17 +13386,18 @@ out_unlock:
 			 "lab submit transition submit_id=%u state=%s completed_packets=%u new_read_offset=%#x new_write_offset=%#x new_ccb_offset=%#x outstanding=%u wrapped=%u complete_seq=%#x complete_cookie=%#x epoch=%u global_running_ticket=%u global_complete_ticket=%u\n",
 			 submit_id,
 			 poulsbo_sgx_lab_owner_state_name(owner_state),
-			 completed_packets, commit->next_state.ccb_read_offset,
-			 commit->next_state.ccb_write_offset,
-			 commit->next_state.ccb_offset,
-			 commit->next_state.queue_packet_count,
-			 !!commit->next_state.queue_head_packet_count,
-			 commit->next_state.sync_complete_seq,
-			 commit->next_state.owner_complete_cookie,
+			 completed_packets,
+			 event->commit.next_state.ccb_read_offset,
+			 event->commit.next_state.ccb_write_offset,
+			 event->commit.next_state.ccb_offset,
+			 event->commit.next_state.queue_packet_count,
+			 !!event->commit.next_state.queue_head_packet_count,
+			 event->commit.next_state.sync_complete_seq,
+			 event->commit.next_state.owner_complete_cookie,
 			 submit->queue_epoch,
-			 commit->next_state.global_running_ticket,
-			 commit->next_state.global_complete_ticket);
-	kfree(commit);
+			 event->commit.next_state.global_running_ticket,
+			 event->commit.next_state.global_complete_ticket);
+	kfree(event);
 	return ret;
 }
 
@@ -13294,7 +13406,7 @@ static int poulsbo_sgx_issue_submit(struct drm_device *dev, u32 submit_id,
 {
 	struct drm_psb_private *dev_priv = dev->dev_private;
 	struct psb_sgx_lab_submit *submit;
-	struct psb_sgx_lab_submit_sgx_ta_commit *commit = NULL;
+	struct psb_sgx_lab_submit_sgx_ta_event *event = NULL;
 	const struct psb_sgx_lab_submit_sgx_issue_image *issue_image;
 	int ret;
 
@@ -13328,33 +13440,25 @@ static int poulsbo_sgx_issue_submit(struct drm_device *dev, u32 submit_id,
 		goto out_unlock;
 	}
 
-	commit = kmalloc(sizeof(*commit), GFP_KERNEL);
-	if (!commit) {
+	event = kmalloc(sizeof(*event), GFP_KERNEL);
+	if (!event) {
 		ret = -ENOMEM;
 		goto out_unlock;
 	}
 
-	ret = poulsbo_sgx_build_submit_sgx_ta_commit_locked(
+	ret = poulsbo_sgx_build_submit_sgx_ta_event_locked(
 		dev_priv, submit, true, owner_state, issued_packets, false, 0, 0,
-		commit);
-	if (ret)
-		goto out_unlock;
-	ret = poulsbo_sgx_submit_sgx_ta_commit_issue_status_locked(commit);
+		event);
 	if (ret) {
 		if (ret == -ESTALE)
 			poulsbo_sgx_disarm_submit_locked(submit);
 		goto out_unlock;
 	}
-	issue_image = &commit->path.dispatch.issue_image;
-	ret = poulsbo_sgx_apply_submit_sgx_ta_commit_locked(
-		dev_priv, submit, commit);
+	issue_image = &event->commit.path.dispatch.issue_image;
+	ret = poulsbo_sgx_apply_submit_sgx_ta_event_locked(
+		dev_priv, submit, event);
 	if (ret)
 		goto out_unlock;
-	submit->issue_count++;
-	if (submit->launch_refilled_from_complete)
-		submit->last_epoch_jiffies = jiffies;
-	submit->last_issue_jiffies = jiffies;
-	ret = poulsbo_sgx_refresh_submit_views_locked(dev_priv, submit);
 
 out_unlock:
 	mutex_unlock(&dev_priv->gtt_mutex);
@@ -13375,7 +13479,7 @@ out_unlock:
 			 submit->launch_refilled_from_complete,
 			 issue_image->sync.global_issue_ticket,
 			 issue_image->owner.global_running_ticket);
-	kfree(commit);
+	kfree(event);
 	return ret;
 }
 
-- 
2.34.1

