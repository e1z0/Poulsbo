+	ret = poulsbo_sgx_build_submit_exec_record_locked(
+		NULL, submit, PSB_SGX_LAB_EXEC_SOURCE_LIVE, &record);
+	if (ret)
+		return ret;
+	expected_head_packets = 0;
+	expected_write_offset = record.ccb_write_offset;
+	if (record.queue_size && record.queue_packet_size &&
+	    record.queue_packet_count) {
+		u32 expected_tail_packets;
+
+		ret = poulsbo_sgx_queue_progression(record.ccb_read_offset,
+						    record.queue_size,
+						    record.queue_packet_size,
+						    record.queue_packet_count,
+						    &expected_tail_packets,
+						    &expected_head_packets,
+						    &expected_write_offset);
+		if (ret)
+			return ret;
+		if (expected_write_offset != record.ccb_write_offset)
+			return -EINVAL;
+	}
+
+	memset(sync, 0, sizeof(*sync));
+	flags = record.sync_flags | PSB_SGX_LAB_SYNC_FLAG_READY;
+	if (expected_head_packets)
+		flags |= PSB_SGX_LAB_SYNC_FLAG_WRAPPED;
+	else
+		flags &= ~PSB_SGX_LAB_SYNC_FLAG_WRAPPED;
+
+	sync->read_offset = record.ccb_read_offset;
+	sync->write_offset = record.ccb_write_offset;
+	sync->complete_seq = record.sync_complete_seq;
+	sync->pending_seq = record.sync_pending_seq;
+	sync->flags = flags;
+	sync->epoch = record.queue_epoch;
+	sync->global_issue_ticket = record.global_issue_ticket;
