+static int poulsbo_sgx_transition_submit(struct drm_device *dev,
+					 u32 submit_id,
+					 u32 owner_state,
+					 u32 completed_packets)
+{
+	struct drm_psb_private *dev_priv = dev->dev_private;
+	struct psb_sgx_lab_submit *submit;
+	struct psb_sgx_lab_object *control_obj;
+	struct psb_sgx_lab_object *pds_obj;
+	struct psb_sgx_lab_object *use_obj;
+	struct psb_sgx_lab_object *target_obj;
+	struct psb_sgx_lab_object *status_obj;
+	struct psb_sgx_lab_queue_header_words queue_header;
+	struct psb_sgx_lab_ccb_record_words ccb_record;
+	struct psb_sgx_lab_sync_words sync;
+	struct psb_sgx_lab_owner_words owner;
+	u32 queue_region_end;
+	u32 sync_region_end;
+	u32 owner_region_end;
+	u32 new_packet_count;
+	u32 new_read_offset;
+	u32 new_write_offset;
+	u32 new_tail_packets;
+	u32 new_head_packets;
+	u32 new_ccb_offset;
+	u32 new_sync_complete_seq;
+	u32 new_sync_flags;
+	u32 new_owner_complete_cookie;
+	u32 new_global_running_ticket;
+	u32 new_global_complete_ticket;
+	bool entering_running;
+	int ret;
+
+	mutex_lock(&dev_priv->sgx_lab_submit_mutex);
+	mutex_lock(&dev_priv->sgx_lab_object_mutex);
+	mutex_lock(&dev_priv->gtt_mutex);
+
+	submit = poulsbo_sgx_find_submit_locked(dev_priv, submit_id);
+	if (!submit) {
+		ret = -ENOENT;
+		goto out_unlock;
+	}
+	if (!submit->control_object_id || !submit->status_object_id ||
+	    !submit->queue_config_count || !submit->ccb_config_count ||
+	    !submit->sync_config_count || !submit->owner_config_count) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+	if (owner_state != PSB_SGX_LAB_OWNER_QUEUED &&
+	    owner_state != PSB_SGX_LAB_OWNER_RUNNING &&
+	    owner_state != PSB_SGX_LAB_OWNER_COMPLETE) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+	if (completed_packets > submit->queue_packet_count) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+
+	if (submit->owner_state == PSB_SGX_LAB_OWNER_COMPLETE) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+	if (owner_state == PSB_SGX_LAB_OWNER_QUEUED) {
+		if (submit->owner_state != PSB_SGX_LAB_OWNER_QUEUED ||
+		    completed_packets) {
+			ret = -EINVAL;
+			goto out_unlock;
+		}
+	} else if (owner_state == PSB_SGX_LAB_OWNER_RUNNING) {
+		if (submit->owner_state != PSB_SGX_LAB_OWNER_QUEUED &&
+		    submit->owner_state != PSB_SGX_LAB_OWNER_RUNNING) {
+			ret = -EINVAL;
+			goto out_unlock;
+		}
+		if (submit->queue_packet_count == completed_packets) {
+			ret = -EINVAL;
+			goto out_unlock;
+		}
+	} else if (owner_state == PSB_SGX_LAB_OWNER_COMPLETE) {
+		if (submit->owner_state != PSB_SGX_LAB_OWNER_RUNNING ||
+		    completed_packets != submit->queue_packet_count) {
+			ret = -EINVAL;
+			goto out_unlock;
+		}
+	}
+	if (submit->owner_state == PSB_SGX_LAB_OWNER_RUNNING) {
+		if (!dev_priv->sgx_lab_running_active ||
+		    dev_priv->sgx_lab_active_running_submit_id != submit_id) {
+			ret = -EINVAL;
+			goto out_unlock;
+		}
+	}
+	entering_running = owner_state == PSB_SGX_LAB_OWNER_RUNNING &&
+			   submit->owner_state != PSB_SGX_LAB_OWNER_RUNNING;
+	new_global_running_ticket = submit->global_running_ticket;
+	if (owner_state == PSB_SGX_LAB_OWNER_RUNNING) {
+		if (entering_running) {
+			unsigned int dependency_slot;
+			bool dependency_active = false;
+
+			if (dev_priv->sgx_lab_running_active) {
+				ret = -EBUSY;
+				goto out_unlock;
+			}
+			for (dependency_slot = 0;
+			     dependency_slot < PSB_SGX_LAB_DEPENDENCY_SLOTS;
+			     dependency_slot++) {
+				if (!poulsbo_sgx_dependency_slot_active(
+					    submit, dependency_slot))
+					continue;
+				dependency_active = true;
+				ret = poulsbo_sgx_dependency_gate_slot_locked(
+					dev_priv, submit, dependency_slot);
+				if (ret && ret != -ENOENT && ret != -EAGAIN)
+					goto out_unlock;
+				if (ret)
+					goto out_unlock;
+			}
+			if (!dependency_active && submit->ta_dependency >
+				    dev_priv->sgx_lab_global_complete_ticket) {
+				ret = -EAGAIN;
+				goto out_unlock;
+			}
+			if (dev_priv->sgx_lab_global_running_ticket ==
+			    U32_MAX) {
+				ret = -EOVERFLOW;
+				goto out_unlock;
+			}
+			new_global_running_ticket =
+				dev_priv->sgx_lab_global_running_ticket + 1;
+		} else if (!submit->global_running_ticket) {
+			ret = -EINVAL;
+			goto out_unlock;
+		}
+	}
+
+	new_packet_count = submit->queue_packet_count - completed_packets;
+	new_read_offset = submit->ccb_read_offset;
+	if (completed_packets) {
+		u64 read_advance;
+		u32 read_advance_mod;
+
+		read_advance = (u64)completed_packets * submit->queue_packet_size;
+		div_u64_rem(read_advance, submit->queue_size, &read_advance_mod);
+		new_read_offset = (submit->ccb_read_offset +
+				   read_advance_mod) %
+				  submit->queue_size;
+	}
+
+	ret = poulsbo_sgx_queue_progression(new_read_offset,
+					    submit->queue_size,
+					    submit->queue_packet_size,
+					    new_packet_count,
+					    &new_tail_packets,
+					    &new_head_packets,
+					    &new_write_offset);
+	if (ret)
+		goto out_unlock;
+
+	new_ccb_offset = submit->queue_base_offset + new_read_offset;
+	new_sync_complete_seq = submit->sync_complete_seq + completed_packets;
+	new_owner_complete_cookie = submit->owner_complete_cookie +
+				    completed_packets;
+	new_global_complete_ticket = submit->global_complete_ticket;
+	if (owner_state == PSB_SGX_LAB_OWNER_COMPLETE) {
+		if (dev_priv->sgx_lab_global_complete_ticket == U32_MAX) {
+			ret = -EOVERFLOW;
+			goto out_unlock;
+		}
+		new_global_complete_ticket =
+			dev_priv->sgx_lab_global_complete_ticket + 1;
+	}
+	new_sync_flags = PSB_SGX_LAB_SYNC_FLAG_READY;
+	if (new_head_packets)
+		new_sync_flags |= PSB_SGX_LAB_SYNC_FLAG_WRAPPED;
+
+	ret = poulsbo_sgx_queue_region_end(submit->queue_base_offset,
+					   submit->queue_size,
+					   &queue_region_end);
+	if (ret)
+		goto out_unlock;
+	ret = poulsbo_sgx_sync_region_end(submit->sync_offset,
+					  &sync_region_end);
+	if (ret)
+		goto out_unlock;
+	ret = poulsbo_sgx_owner_region_end(submit->owner_offset,
+					   &owner_region_end);
+	if (ret)
+		goto out_unlock;
+
+	control_obj = poulsbo_sgx_find_object_locked(dev_priv,
+						     submit->control_object_id);
+	pds_obj = poulsbo_sgx_find_object_locked(dev_priv,
+						 submit->pds_object_id);
+	use_obj = poulsbo_sgx_find_object_locked(dev_priv,
+						 submit->use_object_id);
+	target_obj = poulsbo_sgx_find_object_locked(
+		dev_priv, submit->target_object_id);
+	status_obj = poulsbo_sgx_find_object_locked(dev_priv,
+						    submit->status_object_id);
+	if (!control_obj || !pds_obj || !use_obj || !target_obj || !status_obj) {
+		ret = -ENOENT;
+		goto out_unlock;
+	}
+	if (queue_region_end > control_obj->gt->gem.size ||
+	    new_ccb_offset + PSB_SGX_LAB_CCB_RECORD_BYTES > queue_region_end) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+	ret = poulsbo_sgx_object_access_ok(control_obj, 0, 32);
+	if (ret)
+		goto out_unlock;
+	ret = poulsbo_sgx_object_access_ok(control_obj, new_ccb_offset,
+					   PSB_SGX_LAB_CCB_RECORD_BYTES);
+	if (ret)
+		goto out_unlock;
+	ret = poulsbo_sgx_object_access_ok(status_obj, submit->sync_offset,
+					   sync_region_end - submit->sync_offset);
+	if (ret)
+		goto out_unlock;
+	ret = poulsbo_sgx_object_access_ok(status_obj, submit->owner_offset,
+					   owner_region_end -
+					   submit->owner_offset);
+	if (ret)
+		goto out_unlock;
+
+	memset(&queue_header, 0, sizeof(queue_header));
+	queue_header.write_offset = new_write_offset;
+	queue_header.read_offset = new_read_offset;
+	queue_header.queue_base_offset = submit->queue_base_offset;
+	queue_header.queue_size = submit->queue_size;
+	queue_header.queue_packet_size = submit->queue_packet_size;
+	queue_header.queue_packet_count = new_packet_count;
+	queue_header.queue_tail_packet_count = new_tail_packets;
+	queue_header.queue_head_packet_count = new_head_packets;
+	ret = poulsbo_sgx_write_queue_header_locked(control_obj, 0,
+						    &queue_header);
+	if (ret)
+		goto out_unlock;
+	memset(&ccb_record, 0, sizeof(ccb_record));
+	ccb_record.service_address = submit->ccb_service_address;
+	ccb_record.cache_control = submit->ccb_cache_control;
+	ccb_record.data0 = submit->ccb_data0;
+	ccb_record.data1 = submit->ccb_data1;
+	ccb_record.pds_gpu_va32 =
+		(u32)poulsbo_sgx_object_gpu_va(dev_priv, pds_obj);
+	ccb_record.use_gpu_va32 =
+		(u32)poulsbo_sgx_object_gpu_va(dev_priv, use_obj);
+	ccb_record.target_gpu_va32 =
+		(u32)poulsbo_sgx_object_gpu_va(dev_priv, target_obj);
+	ccb_record.status_gpu_va32 =
+		(u32)poulsbo_sgx_object_gpu_va(dev_priv, status_obj);
+	ret = poulsbo_sgx_write_submit_ccb_record_locked(
+		control_obj, new_ccb_offset, &ccb_record);
+	if (ret)
+		goto out_unlock;
+
+	memset(&sync, 0, sizeof(sync));
+	sync.read_offset = new_read_offset;
+	sync.write_offset = new_write_offset;
+	sync.complete_seq = new_sync_complete_seq;
+	sync.pending_seq = submit->sync_pending_seq;
+	sync.flags = new_sync_flags;
+	sync.epoch = submit->queue_epoch;
+	sync.global_issue_ticket = submit->global_issue_ticket;
+	ret = poulsbo_sgx_write_submit_sync_locked(status_obj,
+						   submit->sync_offset, &sync);
+	if (ret)
+		goto out_unlock;
+
+	memset(&owner, 0, sizeof(owner));
+	owner.owner_state = owner_state;
+	owner.owner_issue_cookie = submit->owner_issue_cookie;
+	owner.owner_complete_cookie = new_owner_complete_cookie;
+	owner.epoch = submit->queue_epoch;
+	owner.global_complete_ticket = new_global_complete_ticket;
+	owner.global_running_ticket = new_global_running_ticket;
+	ret = poulsbo_sgx_write_submit_owner_locked(status_obj,
+						    submit->owner_offset,
+						    &owner);
+	if (ret)
+		goto out_unlock;
+
+	submit->ccb_offset = new_ccb_offset;
+	submit->ccb_read_offset = new_read_offset;
+	submit->ccb_write_offset = new_write_offset;
+	submit->queue_packet_count = new_packet_count;
+	submit->queue_tail_packet_count = new_tail_packets;
+	submit->queue_head_packet_count = new_head_packets;
+	submit->sync_complete_seq = new_sync_complete_seq;
+	submit->sync_flags = new_sync_flags;
+	submit->owner_state = owner_state;
+	submit->owner_complete_cookie = new_owner_complete_cookie;
+	submit->global_running_ticket = new_global_running_ticket;
+	submit->global_complete_ticket = new_global_complete_ticket;
+	poulsbo_sgx_update_dispatch_submit_locked(submit, owner_state,
+						  completed_packets);
+	if (owner_state == PSB_SGX_LAB_OWNER_RUNNING && entering_running) {
+		dev_priv->sgx_lab_global_running_ticket =
+			new_global_running_ticket;
+		dev_priv->sgx_lab_global_running_submit_id = submit_id;
+		dev_priv->sgx_lab_global_running_jiffies = jiffies;
+		dev_priv->sgx_lab_running_active = true;
+		dev_priv->sgx_lab_active_running_submit_id = submit_id;
+	} else if (submit->owner_state != PSB_SGX_LAB_OWNER_RUNNING &&
+		   dev_priv->sgx_lab_running_active &&
+		   dev_priv->sgx_lab_active_running_submit_id == submit_id) {
+		dev_priv->sgx_lab_running_active = false;
+		dev_priv->sgx_lab_active_running_submit_id = 0;
+	}
+	if (owner_state == PSB_SGX_LAB_OWNER_COMPLETE) {
+		dev_priv->sgx_lab_global_complete_ticket =
+			new_global_complete_ticket;
+		dev_priv->sgx_lab_global_complete_submit_id = submit_id;
+		dev_priv->sgx_lab_global_complete_jiffies = jiffies;
+		poulsbo_sgx_retire_submit_locked(submit);
+		ret = poulsbo_sgx_refresh_dependency_dependents_locked(
+			dev_priv, submit_id);
+		if (ret)
+			goto out_unlock;
+	}
+	poulsbo_sgx_disarm_submit_locked(submit);
+	submit->transition_count++;
+	submit->last_transition_jiffies = jiffies;
+	ret = poulsbo_sgx_refresh_submit_views_locked(dev_priv, submit);
+
+out_unlock:
+	mutex_unlock(&dev_priv->gtt_mutex);
+	mutex_unlock(&dev_priv->sgx_lab_object_mutex);
+	mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
+
+	if (!ret)
+		dev_info(dev->dev,
+			 "lab submit transition submit_id=%u state=%s completed_packets=%u new_read_offset=%#x new_write_offset=%#x new_ccb_offset=%#x outstanding=%u wrapped=%u complete_seq=%#x complete_cookie=%#x epoch=%u global_running_ticket=%u global_complete_ticket=%u\n",
+			 submit_id,
+			 poulsbo_sgx_lab_owner_state_name(owner_state),
+			 completed_packets, new_read_offset, new_write_offset,
+			 new_ccb_offset, new_packet_count, !!new_head_packets,
+			 new_sync_complete_seq, new_owner_complete_cookie,
+			 submit->queue_epoch, new_global_running_ticket,
+			 new_global_complete_ticket);
+	return ret;
+}
+
+static int poulsbo_sgx_issue_submit(struct drm_device *dev, u32 submit_id,
+				    u32 owner_state, u32 issued_packets)
+{
+	struct drm_psb_private *dev_priv = dev->dev_private;
+	struct psb_sgx_lab_submit *submit;
+	struct psb_sgx_lab_object *control_obj;
+	struct psb_sgx_lab_object *pds_obj;
+	struct psb_sgx_lab_object *use_obj;
+	struct psb_sgx_lab_object *target_obj;
+	struct psb_sgx_lab_object *status_obj;
+	struct psb_sgx_lab_queue_header_words queue_header;
+	struct psb_sgx_lab_ccb_record_words ccb_record;
+	struct psb_sgx_lab_sync_words sync;
+	struct psb_sgx_lab_owner_words owner;
+	u32 queue_region_end;
+	u32 sync_region_end;
+	u32 owner_region_end;
+	u32 issue_write_offset;
+	u32 slot_offset;
+	u32 index;
+	u32 launch_new_write_offset;
+	u32 launch_queue_packet_count;
+	u32 launch_queue_tail_packet_count;
+	u32 launch_queue_head_packet_count;
+	u32 launch_sync_pending_seq;
+	u32 launch_owner_issue_cookie;
+	u32 launch_queue_epoch;
+	u32 launch_global_issue_ticket;
+	u32 launch_global_running_ticket;
+	u32 launch_pds_gpu_va32;
+	u32 launch_use_gpu_va32;
+	u32 launch_target_gpu_va32;
+	u32 launch_status_gpu_va32;
+	int ret;
+
+	mutex_lock(&dev_priv->sgx_lab_submit_mutex);
+	mutex_lock(&dev_priv->sgx_lab_object_mutex);
+	mutex_lock(&dev_priv->gtt_mutex);
+
+	submit = poulsbo_sgx_find_submit_locked(dev_priv, submit_id);
+	if (!submit) {
+		ret = -ENOENT;
+		goto out_unlock;
+	}
+	if (!submit->control_object_id || !submit->status_object_id ||
+	    !submit->queue_config_count || !submit->ccb_config_count ||
+	    !submit->sync_config_count || !submit->owner_config_count) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+	if (owner_state != PSB_SGX_LAB_OWNER_QUEUED &&
+	    owner_state != PSB_SGX_LAB_OWNER_RUNNING) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+	if (!issued_packets) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+	if (!submit->launch_valid) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+	if (!poulsbo_sgx_submit_launch_matches_locked(dev_priv, submit,
+						      owner_state,
+						      issued_packets)) {
+		poulsbo_sgx_disarm_submit_locked(submit);
+		ret = -ESTALE;
+		goto out_unlock;
+	}
+	ret = poulsbo_sgx_validate_submit_locked(dev_priv, submit);
+	if (ret) {
+		poulsbo_sgx_disarm_submit_locked(submit);
+		goto out_unlock;
+	}
+	launch_new_write_offset = submit->launch_new_write_offset;
+	launch_queue_packet_count = submit->launch_queue_packet_count;
+	launch_queue_tail_packet_count = submit->launch_queue_tail_packet_count;
+	launch_queue_head_packet_count = submit->launch_queue_head_packet_count;
+	launch_sync_pending_seq = submit->launch_sync_pending_seq;
+	launch_owner_issue_cookie = submit->launch_owner_issue_cookie;
+	launch_queue_epoch = submit->launch_queue_epoch;
+	launch_global_issue_ticket = submit->launch_global_issue_ticket;
+	launch_global_running_ticket = submit->launch_global_running_ticket;
+
+	ret = poulsbo_sgx_queue_region_end(submit->launch_queue_base_offset,
+					   submit->launch_queue_size,
+					   &queue_region_end);
+	if (ret)
+		goto out_unlock;
+	ret = poulsbo_sgx_sync_region_end(submit->launch_sync_offset,
+					  &sync_region_end);
+	if (ret)
+		goto out_unlock;
+	ret = poulsbo_sgx_owner_region_end(submit->launch_owner_offset,
+					   &owner_region_end);
+	if (ret)
+		goto out_unlock;
+
+	control_obj = poulsbo_sgx_find_object_locked(dev_priv,
+						     submit->launch_control_object_id);
+	pds_obj = poulsbo_sgx_find_object_locked(dev_priv,
+						 submit->launch_pds_object_id);
+	use_obj = poulsbo_sgx_find_object_locked(dev_priv,
+						 submit->launch_use_object_id);
+	target_obj = poulsbo_sgx_find_object_locked(
+		dev_priv, submit->launch_target_object_id);
+	status_obj = poulsbo_sgx_find_object_locked(dev_priv,
+						    submit->launch_status_object_id);
+	if (!control_obj || !pds_obj || !use_obj || !target_obj || !status_obj) {
+		ret = -ENOENT;
+		goto out_unlock;
+	}
+	if (queue_region_end > control_obj->gt->gem.size) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+	ret = poulsbo_sgx_object_access_ok(control_obj, 0, 32);
+	if (ret)
+		goto out_unlock;
+	launch_pds_gpu_va32 = (u32)submit->launch_pds_gpu_va;
+	launch_use_gpu_va32 = (u32)submit->launch_use_gpu_va;
+	launch_target_gpu_va32 = (u32)submit->launch_target_gpu_va;
+	launch_status_gpu_va32 = (u32)submit->launch_status_gpu_va;
+	ret = poulsbo_sgx_object_access_ok(status_obj, submit->launch_sync_offset,
+					   sync_region_end -
+					   submit->launch_sync_offset);
+	if (ret)
+		goto out_unlock;
+	ret = poulsbo_sgx_object_access_ok(status_obj, submit->launch_owner_offset,
+					   owner_region_end -
+					   submit->launch_owner_offset);
+	if (ret)
+		goto out_unlock;
+
+	issue_write_offset = submit->launch_ccb_write_offset;
+	memset(&ccb_record, 0, sizeof(ccb_record));
+	ccb_record.service_address = submit->launch_ccb_service_address;
+	ccb_record.cache_control = submit->launch_ccb_cache_control;
+	ccb_record.data0 = submit->launch_ccb_data0;
+	ccb_record.data1 = submit->launch_ccb_data1;
+	ccb_record.pds_gpu_va32 = launch_pds_gpu_va32;
+	ccb_record.use_gpu_va32 = launch_use_gpu_va32;
+	ccb_record.target_gpu_va32 = launch_target_gpu_va32;
+	ccb_record.status_gpu_va32 = launch_status_gpu_va32;
+	for (index = 0; index < issued_packets; index++) {
+		slot_offset = submit->launch_queue_base_offset + issue_write_offset;
+		ret = poulsbo_sgx_object_access_ok(control_obj, slot_offset,
+					   PSB_SGX_LAB_CCB_RECORD_BYTES);
+		if (ret)
+			goto out_unlock;
+		ret = poulsbo_sgx_write_submit_ccb_record_locked(
+			control_obj, slot_offset, &ccb_record);
+		if (ret)
+			goto out_unlock;
+		issue_write_offset += submit->launch_queue_packet_size;
+		if (issue_write_offset >= submit->launch_queue_size)
+			issue_write_offset -= submit->launch_queue_size;
+	}
+	if (issue_write_offset != launch_new_write_offset) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+
+	memset(&queue_header, 0, sizeof(queue_header));
+	queue_header.write_offset = launch_new_write_offset;
+	queue_header.read_offset = submit->launch_ccb_read_offset;
+	queue_header.queue_base_offset = submit->launch_queue_base_offset;
+	queue_header.queue_size = submit->launch_queue_size;
+	queue_header.queue_packet_size = submit->launch_queue_packet_size;
+	queue_header.queue_packet_count = launch_queue_packet_count;
+	queue_header.queue_tail_packet_count = launch_queue_tail_packet_count;
+	queue_header.queue_head_packet_count = launch_queue_head_packet_count;
+	ret = poulsbo_sgx_write_queue_header_locked(control_obj, 0,
+						    &queue_header);
+	if (ret)
+		goto out_unlock;
+
+	memset(&sync, 0, sizeof(sync));
+	sync.read_offset = submit->launch_ccb_read_offset;
+	sync.write_offset = launch_new_write_offset;
+	sync.complete_seq = submit->launch_sync_complete_seq;
+	sync.pending_seq = launch_sync_pending_seq;
+	sync.flags = submit->launch_sync_flags;
+	sync.epoch = launch_queue_epoch;
+	sync.global_issue_ticket = launch_global_issue_ticket;
+	ret = poulsbo_sgx_write_submit_sync_locked(status_obj,
+						   submit->launch_sync_offset,
+						   &sync);
+	if (ret)
+		goto out_unlock;
+
+	memset(&owner, 0, sizeof(owner));
+	owner.owner_state = submit->launch_owner_state;
+	owner.owner_issue_cookie = launch_owner_issue_cookie;
+	owner.owner_complete_cookie = submit->launch_owner_complete_cookie;
+	owner.epoch = launch_queue_epoch;
+	owner.global_complete_ticket = submit->launch_global_complete_ticket;
+	owner.global_running_ticket = submit->launch_global_running_ticket;
+	ret = poulsbo_sgx_write_submit_owner_locked(status_obj,
+						    submit->launch_owner_offset,
+						    &owner);
+	if (ret)
+		goto out_unlock;
+
+	submit->ccb_write_offset = launch_new_write_offset;
+	submit->queue_packet_count = launch_queue_packet_count;
+	submit->queue_tail_packet_count = launch_queue_tail_packet_count;
+	submit->queue_head_packet_count = launch_queue_head_packet_count;
+	submit->sync_pending_seq = launch_sync_pending_seq;
+	submit->sync_flags = submit->launch_sync_flags;
+	submit->owner_state = submit->launch_owner_state;
+	submit->owner_issue_cookie = launch_owner_issue_cookie;
+	submit->global_issue_ticket = launch_global_issue_ticket;
+	submit->queue_epoch = launch_queue_epoch;
+	poulsbo_sgx_record_dispatch_submit_locked(submit);
+	poulsbo_sgx_clear_preissue_submit_locked(submit);
+	submit->launch_consumed = true;
+	dev_priv->sgx_lab_global_issue_ticket = launch_global_issue_ticket;
+	dev_priv->sgx_lab_global_issue_submit_id = submit_id;
+	dev_priv->sgx_lab_global_issue_jiffies = jiffies;
+	submit->issue_count++;
+	if (submit->launch_refilled_from_complete)
+		submit->last_epoch_jiffies = jiffies;
+	submit->last_issue_jiffies = jiffies;
+	ret = poulsbo_sgx_refresh_submit_views_locked(dev_priv, submit);
+
+out_unlock:
+	mutex_unlock(&dev_priv->gtt_mutex);
+	mutex_unlock(&dev_priv->sgx_lab_object_mutex);
+	mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
+
+	if (!ret)
+		dev_info(dev->dev,
+			 "lab submit issue submit_id=%u state=%s issued_packets=%u read_offset=%#x new_write_offset=%#x outstanding=%u wrapped=%u pending_seq=%#x issue_cookie=%#x epoch=%u refill=%u global_issue_ticket=%u global_running_ticket=%u\n",
+			 submit_id, poulsbo_sgx_lab_owner_state_name(owner_state),
+			 issued_packets, submit->launch_ccb_read_offset,
+			 launch_new_write_offset, launch_queue_packet_count,
+			 !!launch_queue_head_packet_count,
+			 launch_sync_pending_seq, launch_owner_issue_cookie,
+			 launch_queue_epoch, submit->launch_refilled_from_complete,
+			 launch_global_issue_ticket, launch_global_running_ticket);
+	return ret;
+}
+
+static int poulsbo_sgx_create_submit(struct drm_device *dev, u32 context,
+				     u32 *submit_id_out)
+{
+	struct drm_psb_private *dev_priv = dev->dev_private;
+	struct psb_sgx_lab_submit *submit;
+
+	if (context != PSB_SGX_LAB_CONTEXT_DEFAULT &&
+	    context != PSB_SGX_LAB_CONTEXT_PF)
+		return -EINVAL;
+
+	submit = kzalloc(sizeof(*submit), GFP_KERNEL);
+	if (!submit)
+		return -ENOMEM;
+
+	submit->submit_id = atomic_inc_return(&dev_priv->sgx_lab_submit_id_next);
+	submit->context = context;
+	submit->created_jiffies = jiffies;
+	submit->last_validate_status = -EINVAL;
+
+	mutex_lock(&dev_priv->sgx_lab_submit_mutex);
+	list_add_tail(&submit->head, &dev_priv->sgx_lab_submit_list);
+	mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
+
+	dev_info(dev->dev, "lab submit create submit_id=%u context=%s\n",
+		 submit->submit_id, poulsbo_sgx_lab_context_name(context));
+	if (submit_id_out)
+		*submit_id_out = submit->submit_id;
+	return 0;
+}
+
+static int poulsbo_sgx_drop_submit(struct drm_device *dev, u32 submit_id)
+{
+	struct drm_psb_private *dev_priv = dev->dev_private;
+	struct psb_sgx_lab_submit *submit;
+	int ret;
+
+	mutex_lock(&dev_priv->sgx_lab_submit_mutex);
+	mutex_lock(&dev_priv->sgx_lab_object_mutex);
+	mutex_lock(&dev_priv->gtt_mutex);
+	submit = poulsbo_sgx_find_submit_locked(dev_priv, submit_id);
+	if (!submit) {
+		mutex_unlock(&dev_priv->gtt_mutex);
+		mutex_unlock(&dev_priv->sgx_lab_object_mutex);
+		mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
+		return -ENOENT;
+	}
+
+	list_del(&submit->head);
+	if (dev_priv->sgx_lab_running_active &&
+	    dev_priv->sgx_lab_active_running_submit_id == submit_id) {
+		dev_priv->sgx_lab_running_active = false;
+		dev_priv->sgx_lab_active_running_submit_id = 0;
+	}
+	if (dev_priv->sgx_lab_submit_focus_valid &&
+	    dev_priv->sgx_lab_submit_focus_id == submit_id) {
+		dev_priv->sgx_lab_submit_focus_valid = false;
+		dev_priv->sgx_lab_submit_focus_id = 0;
+		dev_priv->sgx_lab_submit_focus_jiffies = jiffies;
+	}
+	ret = poulsbo_sgx_refresh_dependency_dependents_locked(dev_priv,
+							       submit_id);
+	mutex_unlock(&dev_priv->gtt_mutex);
+	mutex_unlock(&dev_priv->sgx_lab_object_mutex);
+	mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
+	if (ret)
+		return ret;
+
+	dev_info(dev->dev, "lab submit drop submit_id=%u context=%s\n",
+		 submit->submit_id,
+		 poulsbo_sgx_lab_context_name(submit->context));
+	kfree(submit);
+	return 0;
+}
+
+static int poulsbo_sgx_focus_submit(struct drm_device *dev, u32 submit_id)
+{
+	struct drm_psb_private *dev_priv = dev->dev_private;
+	struct psb_sgx_lab_submit *submit;
+
+	mutex_lock(&dev_priv->sgx_lab_submit_mutex);
+	submit = poulsbo_sgx_find_submit_locked(dev_priv, submit_id);
+	if (!submit) {
+		mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
+		return -ENOENT;
+	}
+	dev_priv->sgx_lab_submit_focus_valid = true;
+	dev_priv->sgx_lab_submit_focus_id = submit_id;
+	dev_priv->sgx_lab_submit_focus_jiffies = jiffies;
+	mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
+	return 0;
+}
+
+static void poulsbo_sgx_clear_submit_focus(struct drm_psb_private *dev_priv)
+{
+	dev_priv->sgx_lab_submit_focus_valid = false;
+	dev_priv->sgx_lab_submit_focus_id = 0;
+	dev_priv->sgx_lab_submit_focus_jiffies = jiffies;
+}
+
+static int poulsbo_sgx_attach_submit_object(struct drm_device *dev, u32 submit_id,
+					    const char *slot_name, u32 object_id)
+{
+	struct drm_psb_private *dev_priv = dev->dev_private;
+	struct psb_sgx_lab_submit *submit;
+	struct psb_sgx_lab_object *obj;
+	u32 expected_role;
+	u32 *slot;
+	int ret;
+
+	mutex_lock(&dev_priv->sgx_lab_submit_mutex);
+	mutex_lock(&dev_priv->sgx_lab_object_mutex);
+
+	submit = poulsbo_sgx_find_submit_locked(dev_priv, submit_id);
+	if (!submit) {
+		mutex_unlock(&dev_priv->sgx_lab_object_mutex);
+		mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
+		return -ENOENT;
+	}
+
+	slot = poulsbo_sgx_submit_slot_ptr(submit, slot_name, &expected_role);
+	if (!slot) {
+		mutex_unlock(&dev_priv->sgx_lab_object_mutex);
+		mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
+		return -EINVAL;
+	}
+
+	obj = poulsbo_sgx_find_object_locked(dev_priv, object_id);
+	if (!obj) {
+		mutex_unlock(&dev_priv->sgx_lab_object_mutex);
+		mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
+		return -ENOENT;
+	}
+
+	if (obj->role != expected_role) {
+		mutex_unlock(&dev_priv->sgx_lab_object_mutex);
+		mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
+		return -EINVAL;
+	}
+
+	*slot = object_id;
+	poulsbo_sgx_disarm_submit_locked(submit);
+	ret = poulsbo_sgx_refresh_submit_views_locked(dev_priv, submit);
+	mutex_unlock(&dev_priv->sgx_lab_object_mutex);
+	mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
+	if (ret)
+		return ret;
+
+	dev_info(dev->dev,
+		 "lab submit attach submit_id=%u slot=%s object_id=%u\n",
+		 submit_id, slot_name, object_id);
+	return 0;
+}
+
+static int poulsbo_sgx_detach_submit_object(struct drm_device *dev, u32 submit_id,
+					    const char *slot_name)
+{
+	struct drm_psb_private *dev_priv = dev->dev_private;
+	struct psb_sgx_lab_submit *submit;
+	u32 *slot;
+	int ret;
+
+	mutex_lock(&dev_priv->sgx_lab_submit_mutex);
+	submit = poulsbo_sgx_find_submit_locked(dev_priv, submit_id);
+	if (!submit) {
+		mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
+		return -ENOENT;
+	}
+
+	slot = poulsbo_sgx_submit_slot_ptr(submit, slot_name, NULL);
+	if (!slot) {
+		mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
+		return -EINVAL;
+	}
+
+	*slot = 0;
+	poulsbo_sgx_disarm_submit_locked(submit);
+	ret = poulsbo_sgx_refresh_submit_views_locked(dev_priv, submit);
+	mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
+	if (ret)
+		return ret;
+
+	dev_info(dev->dev, "lab submit detach submit_id=%u slot=%s\n",
+		 submit_id, slot_name);
+	return 0;
+}
+
+static int poulsbo_sgx_validate_submit(struct drm_device *dev, u32 submit_id)
+{
+	struct drm_psb_private *dev_priv = dev->dev_private;
+	struct psb_sgx_lab_submit *submit;
+	int ret;
+
+	mutex_lock(&dev_priv->sgx_lab_submit_mutex);
+	mutex_lock(&dev_priv->sgx_lab_object_mutex);
+	submit = poulsbo_sgx_find_submit_locked(dev_priv, submit_id);
+	if (!submit) {
+		mutex_unlock(&dev_priv->sgx_lab_object_mutex);
+		mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
+		return -ENOENT;
+	}
+
+	ret = poulsbo_sgx_validate_submit_locked(dev_priv, submit);
+	submit->last_validate_status = ret;
+	submit->validate_count++;
+	submit->last_validate_jiffies = jiffies;
+	mutex_unlock(&dev_priv->sgx_lab_object_mutex);
+	mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
+
+	dev_info(dev->dev,
+		 "lab submit validate submit_id=%u context=%s status=%d count=%u\n",
+		 submit_id,
+		 poulsbo_sgx_lab_context_name(submit->context),
+		 ret, submit->validate_count);
+	return ret;
+}
+
+static u32 poulsbo_sgx_drop_all_submits_count(struct drm_device *dev)
+{
+	struct drm_psb_private *dev_priv = dev->dev_private;
+	u32 dropped = 0;
+
+	while (true) {
+		struct psb_sgx_lab_submit *submit;
+
+		mutex_lock(&dev_priv->sgx_lab_submit_mutex);
+		if (list_empty(&dev_priv->sgx_lab_submit_list)) {
+			dev_priv->sgx_lab_running_active = false;
+			dev_priv->sgx_lab_active_running_submit_id = 0;
+			dev_priv->sgx_lab_submit_focus_valid = false;
+			dev_priv->sgx_lab_submit_focus_id = 0;
+			dev_priv->sgx_lab_submit_focus_jiffies = jiffies;
+			mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
+			break;
+		}
+		submit = list_first_entry(&dev_priv->sgx_lab_submit_list,
+					  struct psb_sgx_lab_submit, head);
+		list_del(&submit->head);
+		if (dev_priv->sgx_lab_running_active &&
+		    dev_priv->sgx_lab_active_running_submit_id ==
+			submit->submit_id) {
+			dev_priv->sgx_lab_running_active = false;
+			dev_priv->sgx_lab_active_running_submit_id = 0;
+		}
+		if (dev_priv->sgx_lab_submit_focus_valid &&
+		    dev_priv->sgx_lab_submit_focus_id == submit->submit_id) {
+			dev_priv->sgx_lab_submit_focus_valid = false;
+			dev_priv->sgx_lab_submit_focus_id = 0;
+			dev_priv->sgx_lab_submit_focus_jiffies = jiffies;
+		}
+		mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
+		dev_info(dev->dev, "lab submit drop submit_id=%u during cleanup\n",
+			 submit->submit_id);
+		kfree(submit);
+		dropped++;
+	}
+
+	return dropped;
+}
