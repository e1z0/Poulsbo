 static int poulsbo_sgx_validate_submit_locked(struct drm_psb_private *dev_priv,
 					      struct psb_sgx_lab_submit *submit)
 {
@@ -10963,10 +11111,67 @@ static int poulsbo_sgx_validate_submit_locked(struct drm_psb_private *dev_priv,
 		submit, status_obj, NULL);
 	if (ret)
 		return ret;
-	return poulsbo_sgx_validate_submit_sgx_ta_work_item_locked(
+	return poulsbo_sgx_validate_submit_sgx_ta_op_locked(
 		dev_priv, submit, control_obj, status_obj);
 }
 
+static int poulsbo_sgx_execute_submit_sgx_ta_op(
+	struct drm_device *dev,
+	u32 submit_id,
+	u32 op_kind,
+	u32 owner_state,
+	u32 packet_count,
+	struct psb_sgx_lab_submit_sgx_ta_op **ta_op_out)
+{
+	struct drm_psb_private *dev_priv;
+	struct psb_sgx_lab_submit *submit;
+	struct psb_sgx_lab_submit_sgx_ta_op *ta_op;
+	int ret;
+
+	if (!dev || !ta_op_out)
+		return -EINVAL;
+
+	dev_priv = dev->dev_private;
+	if (!dev_priv)
+		return -ENODEV;
+
+	*ta_op_out = NULL;
+	ta_op = kmalloc(sizeof(*ta_op), GFP_KERNEL);
+	if (!ta_op)
+		return -ENOMEM;
+
+	mutex_lock(&dev_priv->sgx_lab_submit_mutex);
+	mutex_lock(&dev_priv->sgx_lab_object_mutex);
+	mutex_lock(&dev_priv->gtt_mutex);
+
+	submit = poulsbo_sgx_find_submit_locked(dev_priv, submit_id);
+	if (!submit) {
+		ret = -ENOENT;
+		goto out_unlock;
+	}
+
+	ret = poulsbo_sgx_build_submit_sgx_ta_op_locked(
+		dev_priv, submit, op_kind, owner_state, packet_count, ta_op);
+	if (ret)
+		goto out_unlock;
+
+	ret = poulsbo_sgx_apply_submit_sgx_ta_op_locked(
+		dev_priv, submit, ta_op);
+
+out_unlock:
+	mutex_unlock(&dev_priv->gtt_mutex);
+	mutex_unlock(&dev_priv->sgx_lab_object_mutex);
+	mutex_unlock(&dev_priv->sgx_lab_submit_mutex);
+
+	if (ret) {
+		kfree(ta_op);
+		return ret;
+	}
+
+	*ta_op_out = ta_op;
+	return 0;
+}
