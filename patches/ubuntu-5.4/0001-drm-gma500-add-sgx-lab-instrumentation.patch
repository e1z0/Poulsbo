From 1f0490f93893611059ab291fee767349b5eaeddd Mon Sep 17 00:00:00 2001
From: e1z0 <e1z0@icloud.com>
Date: Wed, 13 May 2026 18:45:48 +0300
Subject: [PATCH] drm/gma500: add SGX TA work item object

---
 drivers/gpu/drm/gma500/psb_drv.c | 231 +++++++++++++++++++++----------
 1 file changed, 155 insertions(+), 76 deletions(-)

diff --git a/drivers/gpu/drm/gma500/psb_drv.c b/drivers/gpu/drm/gma500/psb_drv.c
index ed08b0eb8..19b42d8dc 100644
--- a/drivers/gpu/drm/gma500/psb_drv.c
+++ b/drivers/gpu/drm/gma500/psb_drv.c
@@ -1558,6 +1558,16 @@ struct psb_sgx_lab_submit_sgx_ta_event {
 	bool update_last_transition_jiffies;
 };
 
+struct psb_sgx_lab_submit_sgx_ta_work_item {
+	struct psb_sgx_lab_submit_sgx_ta_event event;
+	bool validate_before_apply;
+	bool disarm_on_build_failure;
+	u32 submit_id;
+	u32 owner_state;
+	u32 issued_packets;
+	u32 completed_packets;
+};
+
 static u32 poulsbo_sgx_lab_status_value(u32 seed, bool is_3d, u32 index);
 static int poulsbo_sgx_queue_region_end(u32 base_offset, u32 queue_size,
 					u32 *end_out);
@@ -1636,6 +1646,9 @@ poulsbo_sgx_update_dispatch_submit_locked(struct psb_sgx_lab_submit *submit,
 static int poulsbo_sgx_refresh_submit_views_locked(
 	struct drm_psb_private *dev_priv,
 	struct psb_sgx_lab_submit *submit);
+static int poulsbo_sgx_validate_submit_locked(
+	struct drm_psb_private *dev_priv,
+	struct psb_sgx_lab_submit *submit);
 static int poulsbo_sgx_refresh_dependency_dependents_locked(
 	struct drm_psb_private *dev_priv,
 	u32 completed_submit_id);
@@ -4922,6 +4935,88 @@ static int poulsbo_sgx_apply_submit_sgx_ta_event_locked(
 	return poulsbo_sgx_refresh_submit_views_locked(dev_priv, submit);
 }
 
+static int poulsbo_sgx_build_submit_sgx_ta_work_item_locked(
+	struct drm_psb_private *dev_priv,
+	struct psb_sgx_lab_submit *submit,
+	bool have_issue_request,
+	u32 issue_owner_state,
+	u32 issued_packets,
+	bool have_transition_request,
+	u32 transition_owner_state,
+	u32 completed_packets,
+	struct psb_sgx_lab_submit_sgx_ta_work_item *work_item)
+{
+	int ret;
+
+	if (!dev_priv || !submit || !work_item)
+		return -EINVAL;
+	if (have_issue_request && have_transition_request)
+		return -EINVAL;
+
+	memset(work_item, 0, sizeof(*work_item));
+	work_item->submit_id = submit->submit_id;
+
+	if (!submit->control_object_id || !submit->status_object_id ||
+	    !submit->queue_config_count || !submit->ccb_config_count ||
+	    !submit->sync_config_count || !submit->owner_config_count)
+		return -EINVAL;
+
+	if (have_issue_request) {
+		if (issue_owner_state != PSB_SGX_LAB_OWNER_QUEUED &&
+		    issue_owner_state != PSB_SGX_LAB_OWNER_RUNNING)
+			return -EINVAL;
+		if (!issued_packets)
+			return -EINVAL;
+		work_item->validate_before_apply = true;
+		work_item->disarm_on_build_failure = true;
+		work_item->owner_state = issue_owner_state;
+		work_item->issued_packets = issued_packets;
+	} else if (have_transition_request) {
+		if (transition_owner_state != PSB_SGX_LAB_OWNER_QUEUED &&
+		    transition_owner_state != PSB_SGX_LAB_OWNER_RUNNING &&
+		    transition_owner_state != PSB_SGX_LAB_OWNER_COMPLETE)
+			return -EINVAL;
+		if (completed_packets > submit->queue_packet_count)
+			return -EINVAL;
+		work_item->owner_state = transition_owner_state;
+		work_item->completed_packets = completed_packets;
+	}
+
+	ret = poulsbo_sgx_build_submit_sgx_ta_event_locked(
+		dev_priv, submit, have_issue_request, issue_owner_state,
+		issued_packets, have_transition_request, transition_owner_state,
+		completed_packets, &work_item->event);
+	if (ret) {
+		if (work_item->disarm_on_build_failure && ret == -ESTALE)
+			poulsbo_sgx_disarm_submit_locked(submit);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int poulsbo_sgx_apply_submit_sgx_ta_work_item_locked(
+	struct drm_psb_private *dev_priv,
+	struct psb_sgx_lab_submit *submit,
+	const struct psb_sgx_lab_submit_sgx_ta_work_item *work_item)
+{
+	int ret;
+
+	if (!dev_priv || !submit || !work_item)
+		return -EINVAL;
+
+	if (work_item->validate_before_apply) {
+		ret = poulsbo_sgx_validate_submit_locked(dev_priv, submit);
+		if (ret) {
+			poulsbo_sgx_disarm_submit_locked(submit);
+			return ret;
+		}
+	}
+
+	return poulsbo_sgx_apply_submit_sgx_ta_event_locked(
+		dev_priv, submit, &work_item->event);
+}
+
 static int poulsbo_sgx_collect_submit_view_records_locked(
 	struct drm_psb_private *dev_priv,
 	struct psb_sgx_lab_submit *submit,
@@ -10603,17 +10698,40 @@ static int poulsbo_sgx_validate_built_submit_sgx_ta_event_locked(
 		event->update_last_transition_jiffies) ? -EINVAL : 0;
 }
 
-static int poulsbo_sgx_validate_submit_sgx_ta_event_locked(
+static int poulsbo_sgx_validate_built_submit_sgx_ta_work_item_locked(
+	struct drm_psb_private *dev_priv,
+	struct psb_sgx_lab_submit *submit,
+	const struct psb_sgx_lab_submit_sgx_ta_work_item *work_item)
+{
+	int ret;
+
+	if (!dev_priv || !submit || !work_item)
+		return -EINVAL;
+
+	ret = poulsbo_sgx_validate_built_submit_sgx_ta_event_locked(
+		dev_priv, submit, &work_item->event);
+	if (ret)
+		return ret;
+	if (work_item->submit_id != submit->submit_id)
+		return -EINVAL;
+
+	return (work_item->validate_before_apply ||
+		work_item->disarm_on_build_failure ||
+		work_item->owner_state || work_item->issued_packets ||
+		work_item->completed_packets) ? -EINVAL : 0;
+}
+
+static int poulsbo_sgx_validate_submit_sgx_ta_work_item_locked(
 	struct drm_psb_private *dev_priv,
 	struct psb_sgx_lab_submit *submit,
 	struct psb_sgx_lab_object *control_obj,
 	struct psb_sgx_lab_object *status_obj)
 {
-	struct psb_sgx_lab_submit_sgx_ta_event *event;
+	struct psb_sgx_lab_submit_sgx_ta_work_item *work_item;
 	int ret;
 
-	event = kmalloc(sizeof(*event), GFP_KERNEL);
-	if (!event)
+	work_item = kmalloc(sizeof(*work_item), GFP_KERNEL);
+	if (!work_item)
 		return -ENOMEM;
 
 	ret = poulsbo_sgx_validate_submit_sgx_ta_dispatch_locked(
@@ -10621,16 +10739,16 @@ static int poulsbo_sgx_validate_submit_sgx_ta_event_locked(
 	if (ret)
 		goto out;
 
-	ret = poulsbo_sgx_build_submit_sgx_ta_event_locked(
-		dev_priv, submit, false, 0, 0, false, 0, 0, event);
+	ret = poulsbo_sgx_build_submit_sgx_ta_work_item_locked(
+		dev_priv, submit, false, 0, 0, false, 0, 0, work_item);
 	if (ret)
 		goto out;
 
-	ret = poulsbo_sgx_validate_built_submit_sgx_ta_event_locked(
-		dev_priv, submit, event);
+	ret = poulsbo_sgx_validate_built_submit_sgx_ta_work_item_locked(
+		dev_priv, submit, work_item);
 
 out:
-	kfree(event);
+	kfree(work_item);
 	return ret;
 }
 
@@ -10845,7 +10963,7 @@ static int poulsbo_sgx_validate_submit_locked(struct drm_psb_private *dev_priv,
 		submit, status_obj, NULL);
 	if (ret)
 		return ret;
-	return poulsbo_sgx_validate_submit_sgx_ta_event_locked(
+	return poulsbo_sgx_validate_submit_sgx_ta_work_item_locked(
 		dev_priv, submit, control_obj, status_obj);
 }
 
@@ -13333,7 +13451,7 @@ static int poulsbo_sgx_transition_submit(struct drm_device *dev,
 {
 	struct drm_psb_private *dev_priv = dev->dev_private;
 	struct psb_sgx_lab_submit *submit;
-	struct psb_sgx_lab_submit_sgx_ta_event *event = NULL;
+	struct psb_sgx_lab_submit_sgx_ta_work_item *work_item = NULL;
 	int ret;
 
 	mutex_lock(&dev_priv->sgx_lab_submit_mutex);
@@ -13345,36 +13463,20 @@ static int poulsbo_sgx_transition_submit(struct drm_device *dev,
 		ret = -ENOENT;
 		goto out_unlock;
 	}
-	if (!submit->control_object_id || !submit->status_object_id ||
-	    !submit->queue_config_count || !submit->ccb_config_count ||
-	    !submit->sync_config_count || !submit->owner_config_count) {
-		ret = -EINVAL;
-		goto out_unlock;
-	}
-	if (owner_state != PSB_SGX_LAB_OWNER_QUEUED &&
-	    owner_state != PSB_SGX_LAB_OWNER_RUNNING &&
-	    owner_state != PSB_SGX_LAB_OWNER_COMPLETE) {
-		ret = -EINVAL;
-		goto out_unlock;
-	}
-	if (completed_packets > submit->queue_packet_count) {
-		ret = -EINVAL;
-		goto out_unlock;
-	}
 
-	event = kmalloc(sizeof(*event), GFP_KERNEL);
-	if (!event) {
+	work_item = kmalloc(sizeof(*work_item), GFP_KERNEL);
+	if (!work_item) {
 		ret = -ENOMEM;
 		goto out_unlock;
 	}
 
-	ret = poulsbo_sgx_build_submit_sgx_ta_event_locked(
+	ret = poulsbo_sgx_build_submit_sgx_ta_work_item_locked(
 		dev_priv, submit, false, 0, 0, true, owner_state,
-		completed_packets, event);
+		completed_packets, work_item);
 	if (ret)
 		goto out_unlock;
-	ret = poulsbo_sgx_apply_submit_sgx_ta_event_locked(
-		dev_priv, submit, event);
+	ret = poulsbo_sgx_apply_submit_sgx_ta_work_item_locked(
+		dev_priv, submit, work_item);
 
 out_unlock:
 	mutex_unlock(&dev_priv->gtt_mutex);
@@ -13387,17 +13489,17 @@ out_unlock:
 			 submit_id,
 			 poulsbo_sgx_lab_owner_state_name(owner_state),
 			 completed_packets,
-			 event->commit.next_state.ccb_read_offset,
-			 event->commit.next_state.ccb_write_offset,
-			 event->commit.next_state.ccb_offset,
-			 event->commit.next_state.queue_packet_count,
-			 !!event->commit.next_state.queue_head_packet_count,
-			 event->commit.next_state.sync_complete_seq,
-			 event->commit.next_state.owner_complete_cookie,
+			 work_item->event.commit.next_state.ccb_read_offset,
+			 work_item->event.commit.next_state.ccb_write_offset,
+			 work_item->event.commit.next_state.ccb_offset,
+			 work_item->event.commit.next_state.queue_packet_count,
+			 !!work_item->event.commit.next_state.queue_head_packet_count,
+			 work_item->event.commit.next_state.sync_complete_seq,
+			 work_item->event.commit.next_state.owner_complete_cookie,
 			 submit->queue_epoch,
-			 event->commit.next_state.global_running_ticket,
-			 event->commit.next_state.global_complete_ticket);
-	kfree(event);
+			 work_item->event.commit.next_state.global_running_ticket,
+			 work_item->event.commit.next_state.global_complete_ticket);
+	kfree(work_item);
 	return ret;
 }
 
@@ -13406,7 +13508,7 @@ static int poulsbo_sgx_issue_submit(struct drm_device *dev, u32 submit_id,
 {
 	struct drm_psb_private *dev_priv = dev->dev_private;
 	struct psb_sgx_lab_submit *submit;
-	struct psb_sgx_lab_submit_sgx_ta_event *event = NULL;
+	struct psb_sgx_lab_submit_sgx_ta_work_item *work_item = NULL;
 	const struct psb_sgx_lab_submit_sgx_issue_image *issue_image;
 	int ret;
 
@@ -13419,44 +13521,21 @@ static int poulsbo_sgx_issue_submit(struct drm_device *dev, u32 submit_id,
 		ret = -ENOENT;
 		goto out_unlock;
 	}
-	if (!submit->control_object_id || !submit->status_object_id ||
-	    !submit->queue_config_count || !submit->ccb_config_count ||
-	    !submit->sync_config_count || !submit->owner_config_count) {
-		ret = -EINVAL;
-		goto out_unlock;
-	}
-	if (owner_state != PSB_SGX_LAB_OWNER_QUEUED &&
-	    owner_state != PSB_SGX_LAB_OWNER_RUNNING) {
-		ret = -EINVAL;
-		goto out_unlock;
-	}
-	if (!issued_packets) {
-		ret = -EINVAL;
-		goto out_unlock;
-	}
-	ret = poulsbo_sgx_validate_submit_locked(dev_priv, submit);
-	if (ret) {
-		poulsbo_sgx_disarm_submit_locked(submit);
-		goto out_unlock;
-	}
 
-	event = kmalloc(sizeof(*event), GFP_KERNEL);
-	if (!event) {
+	work_item = kmalloc(sizeof(*work_item), GFP_KERNEL);
+	if (!work_item) {
 		ret = -ENOMEM;
 		goto out_unlock;
 	}
 
-	ret = poulsbo_sgx_build_submit_sgx_ta_event_locked(
+	ret = poulsbo_sgx_build_submit_sgx_ta_work_item_locked(
 		dev_priv, submit, true, owner_state, issued_packets, false, 0, 0,
-		event);
-	if (ret) {
-		if (ret == -ESTALE)
-			poulsbo_sgx_disarm_submit_locked(submit);
+		work_item);
+	if (ret)
 		goto out_unlock;
-	}
-	issue_image = &event->commit.path.dispatch.issue_image;
-	ret = poulsbo_sgx_apply_submit_sgx_ta_event_locked(
-		dev_priv, submit, event);
+	issue_image = &work_item->event.commit.path.dispatch.issue_image;
+	ret = poulsbo_sgx_apply_submit_sgx_ta_work_item_locked(
+		dev_priv, submit, work_item);
 	if (ret)
 		goto out_unlock;
 
@@ -13479,7 +13558,7 @@ out_unlock:
 			 submit->launch_refilled_from_complete,
 			 issue_image->sync.global_issue_ticket,
 			 issue_image->owner.global_running_ticket);
-	kfree(event);
+	kfree(work_item);
 	return ret;
 }
 
-- 
