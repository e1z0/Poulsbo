+			 "echo 'depstate2 submit_id offset' > poulsbo_sgx_submit\n"
+			 "echo 'depstate3 submit_id offset' > poulsbo_sgx_submit\n"
+			 "echo 'depstate_slot submit_id slot offset' > poulsbo_sgx_submit\n"
