+struct psb_sgx_lab_submit_sgx_scheduler_state {
+	u32 issue_ticket;
+	u32 running_ticket;
+	u32 complete_ticket;
+	u32 issue_submit_id;
+	u32 running_submit_id;
+	u32 complete_submit_id;
+	bool active_running_valid;
