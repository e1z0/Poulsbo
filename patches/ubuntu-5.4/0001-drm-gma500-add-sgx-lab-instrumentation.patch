From 2f7c1551a69f17856389ca4ca681f209dea78d64 Mon Sep 17 00:00:00 2001
From: e1z0 <e1z0@icloud.com>
Date: Fri, 15 May 2026 19:38:20 +0300
Subject: [PATCH] drm/gma500: add SGX TA submit-op request sysfs

---
 drivers/gpu/drm/gma500/psb_drv.c | 86 +++++++++++++++++++++++++++++---
 1 file changed, 78 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/gma500/psb_drv.c b/drivers/gpu/drm/gma500/psb_drv.c
index c6ae12394..fa3a70f3d 100644
--- a/drivers/gpu/drm/gma500/psb_drv.c
+++ b/drivers/gpu/drm/gma500/psb_drv.c
@@ -2985,6 +2985,21 @@ struct psb_sgx_lab_submit_sgx_ta_submit_op_request_command {
 	u32 request_command_op;
 };
 
+struct psb_sgx_lab_submit_sgx_ta_submit_op_request_sysfs {
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_command
+		submit_op_request_command;
+	struct drm_psb_sgx_lab_submit_op request_op;
+	struct drm_psb_sgx_lab_submit_op response_op;
+	struct psb_sgx_lab_submit_sgx_ta_request_work_outcome outcome;
+	bool active;
+	bool dependency_fields_present;
+	bool compatibility_request_sysfs;
+	bool issue_request_sysfs;
+	bool transition_request_sysfs;
+	u32 resolved_submit_id;
+	u32 request_sysfs_op;
+};
+
 static u32 poulsbo_sgx_lab_status_value(u32 seed, bool is_3d, u32 index);
 static int poulsbo_sgx_queue_region_end(u32 base_offset, u32 queue_size,
 					u32 *end_out);
@@ -20341,6 +20356,61 @@ out_free_command:
 	return ret;
 }
 
+static int poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_sysfs(
+	struct drm_device *dev,
+	u32 op_kind,
+	u32 submit_id,
+	u32 owner_state,
+	u32 packet_count,
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_sysfs **return_out)
+{
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_command *command =
+		NULL;
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_sysfs *sysfs;
+	int ret;
+
+	if (!dev || !return_out)
+		return -EINVAL;
+	if (op_kind != DRM_PSB_SGX_LAB_SUBMIT_OP_ISSUE &&
+	    op_kind != DRM_PSB_SGX_LAB_SUBMIT_OP_TRANSITION)
+		return -EINVAL;
+
+	*return_out = NULL;
+	sysfs = kzalloc(sizeof(*sysfs), GFP_KERNEL);
+	if (!sysfs)
+		return -ENOMEM;
+
+	ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_command(
+		dev, op_kind, submit_id, owner_state, packet_count, &command);
+	if (ret)
+		goto out_free_sysfs;
+
+	sysfs->submit_op_request_command = *command;
+	sysfs->request_op = command->request_op;
+	sysfs->response_op = command->response_op;
+	sysfs->outcome = command->outcome;
+	sysfs->active = command->active;
+	sysfs->dependency_fields_present =
+		command->dependency_fields_present;
+	sysfs->compatibility_request_sysfs =
+		command->compatibility_request_command;
+	sysfs->issue_request_sysfs =
+		command->issue_request_command;
+	sysfs->transition_request_sysfs =
+		command->transition_request_command;
+	sysfs->resolved_submit_id = command->resolved_submit_id;
+	sysfs->request_sysfs_op = op_kind;
+
+	kfree(command);
+	*return_out = sysfs;
+	return 0;
+
+out_free_sysfs:
+	kfree(command);
+	kfree(sysfs);
+	return ret;
+}
+
 static int poulsbo_sgx_prepare_queue_packets_locked(
 	struct psb_sgx_lab_object *control_obj,
 	struct psb_sgx_lab_submit *submit,
@@ -22823,28 +22893,28 @@ static int poulsbo_sgx_transition_submit(struct drm_device *dev,
 					 u32 owner_state,
 					 u32 completed_packets)
 {
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_command *command =
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_sysfs *sysfs =
 		NULL;
 	int ret;
 
-	ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_command(
+	ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_sysfs(
 		dev, DRM_PSB_SGX_LAB_SUBMIT_OP_TRANSITION, submit_id,
-		owner_state, completed_packets, &command);
-	kfree(command);
+		owner_state, completed_packets, &sysfs);
+	kfree(sysfs);
 	return ret;
 }
 
 static int poulsbo_sgx_issue_submit(struct drm_device *dev, u32 submit_id,
 				    u32 owner_state, u32 issued_packets)
 {
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_command *command =
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_sysfs *sysfs =
 		NULL;
 	int ret;
 
-	ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_command(
+	ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_sysfs(
 		dev, DRM_PSB_SGX_LAB_SUBMIT_OP_ISSUE, submit_id,
-		owner_state, issued_packets, &command);
-	kfree(command);
+		owner_state, issued_packets, &sysfs);
+	kfree(sysfs);
 	return ret;
 }
 
-- 
2.34.1

