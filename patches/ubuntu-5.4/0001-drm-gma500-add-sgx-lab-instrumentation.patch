From b0ee9b4faf4ef74518aeed2971bc6164997fda49 Mon Sep 17 00:00:00 2001
From: e1z0 <e1z0@icloud.com>
Date: Sat, 16 May 2026 01:28:58 +0300
Subject: [PATCH] drm/gma500: fold SGX TA request relay into request portal

---
 drivers/gpu/drm/gma500/psb_drv.c | 86 +++++---------------------------
 1 file changed, 13 insertions(+), 73 deletions(-)

diff --git a/drivers/gpu/drm/gma500/psb_drv.c b/drivers/gpu/drm/gma500/psb_drv.c
index f7701dc5d..cafc9338d 100644
--- a/drivers/gpu/drm/gma500/psb_drv.c
+++ b/drivers/gpu/drm/gma500/psb_drv.c
@@ -2852,20 +2852,6 @@ struct psb_sgx_lab_submit_sgx_ta_submit_op_request_bridge {
 	u32 request_bridge_op;
 };
 
-struct psb_sgx_lab_submit_sgx_ta_submit_op_request_relay {
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_portal
-		submit_op_request_portal;
-	struct drm_psb_sgx_lab_submit_op request_op;
-	struct drm_psb_sgx_lab_submit_op response_op;
-	struct psb_sgx_lab_submit_sgx_ta_request_work_outcome outcome;
-	bool active;
-	bool dependency_fields_present;
-	bool issue_request_relay;
-	bool transition_request_relay;
-	u32 resolved_submit_id;
-	u32 request_relay_op;
-};
-
 static u32 poulsbo_sgx_lab_status_value(u32 seed, bool is_3d, u32 index);
 static int poulsbo_sgx_queue_region_end(u32 base_offset, u32 queue_size,
 					u32 *end_out);
@@ -19705,52 +19691,6 @@ out_free_bridge:
 	return ret;
 }
 
-static int poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_relay(
-	struct drm_device *dev,
-	const struct drm_psb_sgx_lab_submit_op *op,
-	bool dependency_fields_present,
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_relay **return_out)
-{
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_portal
-		*portal = NULL;
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_relay *relay;
-	int ret;
-
-	if (!dev || !op || !return_out)
-		return -EINVAL;
-
-	*return_out = NULL;
-	relay = kmalloc(sizeof(*relay), GFP_KERNEL);
-	if (!relay)
-		return -ENOMEM;
-
-	ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_portal(
-		dev, op, dependency_fields_present, &portal);
-	if (ret)
-		goto out_free_relay;
-
-	relay->submit_op_request_portal = *portal;
-	relay->request_op = portal->request_op;
-	relay->response_op = portal->response_op;
-	relay->outcome = portal->outcome;
-	relay->active = portal->active;
-	relay->dependency_fields_present =
-		portal->dependency_fields_present;
-	relay->issue_request_relay = portal->issue_request_portal;
-	relay->transition_request_relay =
-		portal->transition_request_portal;
-	relay->resolved_submit_id = portal->resolved_submit_id;
-	relay->request_relay_op = op->op;
-
-	kfree(portal);
-	*return_out = relay;
-	return 0;
-
-out_free_relay:
-	kfree(relay);
-	return ret;
-}
-
 static int poulsbo_sgx_prepare_queue_packets_locked(
 	struct psb_sgx_lab_object *control_obj,
 	struct psb_sgx_lab_submit *submit,
@@ -25872,7 +25812,7 @@ static int psb_ioctl_sgx_lab_submit_op(struct drm_device *dev, void *data,
 {
 	struct drm_psb_private *dev_priv = dev->dev_private;
 	struct drm_psb_sgx_lab_submit_op *op = data;
-	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_relay *request_relay =
+	struct psb_sgx_lab_submit_sgx_ta_submit_op_request_portal *request_portal =
 		NULL;
 	const char *slot_name = NULL;
 	bool dependency_fields_present;
@@ -26123,16 +26063,16 @@ static int psb_ioctl_sgx_lab_submit_op(struct drm_device *dev, void *data,
 						op->packet_count);
 		break;
 	case DRM_PSB_SGX_LAB_SUBMIT_OP_ISSUE:
-		ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_relay(
-			dev, op, dependency_fields_present, &request_relay);
+		ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_portal(
+			dev, op, dependency_fields_present, &request_portal);
 		if (!ret)
-			submit_id = request_relay->response_op.resolved_submit_id;
+			submit_id = request_portal->response_op.resolved_submit_id;
 		break;
 	case DRM_PSB_SGX_LAB_SUBMIT_OP_TRANSITION:
-		ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_relay(
-			dev, op, dependency_fields_present, &request_relay);
+		ret = poulsbo_sgx_execute_submit_sgx_ta_submit_op_request_portal(
+			dev, op, dependency_fields_present, &request_portal);
 		if (!ret)
-			submit_id = request_relay->response_op.resolved_submit_id;
+			submit_id = request_portal->response_op.resolved_submit_id;
 		break;
 	case DRM_PSB_SGX_LAB_SUBMIT_OP_ATTACH:
 		if (op->owner_state || op->packet_count || op->context ||
@@ -26573,17 +26513,17 @@ static int psb_ioctl_sgx_lab_submit_op(struct drm_device *dev, void *data,
 		return -EINVAL;
 	}
 	if (ret)
-		goto out_free_request_relay;
-	if (request_relay) {
-		kfree(request_relay);
-		request_relay = NULL;
+		goto out_free_request_portal;
+	if (request_portal) {
+		kfree(request_portal);
+		request_portal = NULL;
 	}
 
 	op->resolved_submit_id = submit_id;
 	return 0;
 
-out_free_request_relay:
-	kfree(request_relay);
+out_free_request_portal:
+	kfree(request_portal);
 	return ret;
 }
 
-- 
2.34.1

