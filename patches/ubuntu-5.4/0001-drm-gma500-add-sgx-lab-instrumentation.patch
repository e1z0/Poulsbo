 	int ret;
 
 	mutex_lock(&dev_priv->sgx_lab_submit_mutex);
@@ -12014,111 +12300,46 @@ static int poulsbo_sgx_transition_submit(struct drm_device *dev,
 		goto out_unlock;
 	}
 
