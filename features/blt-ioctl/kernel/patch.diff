+/**
+ *	psb_gtt_unpin_idle	-	drop a GTT pin, blitter already quiesced
+ *	@gt: range to unpin
+ *
+ *	As psb_gtt_unpin(), but for callers that have already quiesced (or
+ *	reset) the 2D engine with respect to this range: skips the blitter
+ *	idle wait inside psb_gtt_unpin_locked(), whose silent -EBUSY return
+ *	would otherwise leave in_gart permanently elevated (a pin leak)
+ *	whenever an unrelated workload keeps the engine busy past the 1s
+ *	window.  Used by the DRM_PSB_BLT_SUBMIT unwind path (blt_submit.c).
+ */
+void psb_gtt_unpin_idle(struct gtt_range *gt)
+{
+	struct drm_device *dev = gt->gem.dev;
+	struct drm_psb_private *dev_priv = dev->dev_private;
+
+	mutex_lock(&dev_priv->gtt_mutex);
+	psb_gtt_unpin_locked(gt, true);
+	mutex_unlock(&dev_priv->gtt_mutex);
+}
