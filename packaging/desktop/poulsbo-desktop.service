[Unit]
Description=Poulsbo accelerated desktop (Xorg + MATE/marco, HW 2D + HW GL)
After=poulsbo-sgx.service poulsbo-sgx-srvinit.service systemd-user-sessions.service
Wants=poulsbo-sgx-srvinit.service
Conflicts=getty@tty7.service

[Service]
# Rootful Xorg on tty7 via startx + /root/.xinitrc (marco + HW 2D + HW GL, no
# compiz).  Known-good systemd-startx pattern: give the service the tty, run as
# root (avoids logind seat/permission setup), reset the tty on exit.  PAMName is
# intentionally omitted -- rootful X needs no PAM session and it is a common
# failure point.
Type=simple
User=root
TTYPath=/dev/tty7
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
UtmpIdentifier=tty7
ExecStart=/usr/bin/startx -- :0 vt7 -nolisten tcp
Restart=on-failure
RestartSec=8

[Install]
WantedBy=multi-user.target
